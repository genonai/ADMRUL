  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은 공무원임용령 제5조의2 및 국토해양부 인사관리규정 제5조의 규정에 의하여 국립해양조사원 소속 공무원에 대한 인사운영의 원칙과 기준을 규정함으로써 공정하고 투명한 인사운영을 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용 범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용 범위) 이 지침은 국립해양조사원(소속기관을 포함한다. 이하 같다) 일반직 및 기능직공무원에 대하여 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "인사 시행시기",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(인사 시행시기) 국립해양조사원장(이하 \"원장\"이라 한다)은 안정적이고  예측이 가능한 인사 관리를 위하여 매년 1월 15일에 정기인사를 실시하며, 원장이 필요하다고 인정하는 경우 수시인사를 실시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "인사 예고",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(인사 예고) 정기인사는 인사 시행 1개월 이전에, 수시인사는 1주일 전까지 인사 시행 사유, 대상 직급 및  예정 일시를 전 직원에게 공지한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "희망 인사",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(희망 인사) 원장은 매년 11월에 정기적으로 전 직원의 희망보직을 조사하여 최대한 인사에 반영하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "적재적소 배치",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(적재적소 배치) ①원장은 제5조의 규정에 의한 희망보직 조사결과를 고려하여 적재적소에 인력이 배치될 수 있도록 하여야 한다.②수로직 신규임용 공무원은 본원의 각과에서 마련한 신규직원 능력배양프로그램에 따라 2년 이내의 기본실무과정을 거친 후 지방소에 배치한다.③팀장급은 2년, 일반 팀원은 3년 주기로 본인의 순환 보직경로를 설정하여야 하며, 원장은 직원들이 희망하는 보직경로를 최대한 반영하여 전보하여야 한다.④업무 분야별 전문인력을 양성하기 위하여 본원 각과의 주무관 1명, 실무관 2명을 전문관으로 선정하되, 전문주무관은 5년 이내, 전문실무관은 3년 이내에 다른 부서로 전보하지 아니함을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "본원과 지방소간의 전보 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(본원과 지방소간의 전보 등) ①동일 직위에서의 장기 근무로 인한 업무  침체를 방지하고 근무의욕 향상을 위하여 장기근무자를 대상으로 본원과 해양조사사무소(이하 \"지방소\"라 한다), 지방소와 지방소간의 순환 전보를 정기적으로 실시한다.②순환 전보 대상자 명단은 총무과장이 직급 별로 균등하게 지명한 11인 이내의 공무원으로 심사위원회를 구성하여 심의·확정하며 그 명단을 변경할 경우에도 심사위원회의 심의를 거쳐야한다.③제1항의 규정에 의하여 순환 전보한 공무원은 발령일로부터 2년이 경과된 시점에 본인의 희망보직을 최대한 반영하여 재전보하여야 한다.④동일한 선박에서 3년 이상 근무한 선박직원은 다른 선박에 순환 배치하는 것을 원칙으로 하되, 세부적인 순환 배치 기준은 본원 측량과에서 지방소와 협의하여 수립한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "보통승진심사위원회",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(보통승진심사위원회) ①7급 이하 일반직공무원과 기능직공무원(선박에서 근무하는 기능직공무원은 제외한다)의 승진을 심사하기 위한 보통승진심사위원회는 위원장을 포함한 7인 이내의 위원으로 구성하되 위원장은 4급 공무원 중에서 원장이 임명하는 자로 하고, 위원은 승진임용 예정직급에 해당하는  계급의 상위 계급자 중에서 각과의 추천을 받은 5급 이하 일반직공무원을   원장이 지명한다.②선박에서 근무하는 기능직공무원의 승진을 심사하기 위한 보통승진심사위원회는 위원장을 포함한 7인 이내의 위원으로 구성하되 위원장은 위원 중 직제상 상위 서열자로 하고, 위원은 승진임용 예정 직급에 해당하는 계급의 상위계급자 중에서 각 지방소의 추천을 받아 원장이 지명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "인사 청탁의 금지",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(인사 청탁의 금지) ①모든 직원은 공무원행동강령 제9조에 규정된 인사  청탁을 하여서는 아니된다.②인사청탁을 받은 자는 반드시 이를 공표하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "인사운영지침 시행에 대한 평가",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(인사운영지침 시행에 대한 평가) 인사 담당은 매년 1회 이상 인사운영  지침 시행에 따른 만족도 조사를 실시하고, 그 결과에 따른 개선책을 지속적으로 수립·시행하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립해양조사원인사운영지침#JO0010"
      }
