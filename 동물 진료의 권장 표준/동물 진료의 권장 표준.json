    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 고시는 「수의사법」 제20조의3에 따라 동물 진료에 관한 표준을 정하여 동물진료업에 종사하는 수의사에게 그 적용을 권장함으로써 동물 진료의 투명화와 체계적인 발전에 기여함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:동물진료의권장표준#JO0001"
