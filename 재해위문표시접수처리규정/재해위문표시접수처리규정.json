    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 아국에 수해, 화재 등 대형재해가 발생하였을 경우 외국정부 및 기관으로부터 접수되는 각종 위문표시에 대한 업무처리 절차를 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재해위문표시접수처리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "주관부서",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(주관부서) 아국의 재해와 관련 외국으로부터 접수되는 각종 위문표시에 대한 업무는위문표시를 접수한 관계 지역과가 주관하여 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재해위문표시접수처리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "위문전보 및 서한처리 절차",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(위문전보 및 서한처리 절차) ① 국가원수·총리급 명의의 위문전보 또는 서한으로서 외교통상부가 직접 접수한 것은관계지역과가 수신기관에 즉시 보고후 수신기관의 지시에 따라 조치하고 수신기관의지시가 있으면 그에 따라 관계지역과가 조치를 취한다.② 외상명의의 위문전보 및 서한 등에 대하여는 관계지역과가 응신조치를 취한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재해위문표시접수처리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위문금품 처리 절차",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(위문금품 처리 절차) 외교통상부가 직접 접수하거나 타부처 또는 기관에서 접수하여 외교통상부로 이첩된 위문금품에 대하여는 관계지역과의 주관하에 원칙적으로 대한적십자사에 전달하며, 동 금품을 송부한 외국기관에 대하여 아국의 적절한 인사명의의 감사서한 발송 등사의표시조치를 취한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재해위문표시접수처리규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "업무 처리 통보",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(업무 처리 통보) 위문표시를 접수처리한 관계지역과는 위문표시의 접수사실 및 처리결과 등을 의전장소속의 특전담당관 및 공보관에게 수시로 통보하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재해위문표시접수처리규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "총괄부서",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(총괄부서) 특전담당관은 위문표시와 관련된 상황을 종합적으로 파악하여 외교통상부 장관 및 차관에게 수시로 보고하고 필요한 경우 관계실·국장에게도 통보하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재해위문표시접수처리규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "대외발표",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(대외발표) 공보관은 위문표시에 대한 외교통상부 조치사항을 대외적으로 발표한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재해위문표시접수처리규정#JO0007"
      }
    ]
