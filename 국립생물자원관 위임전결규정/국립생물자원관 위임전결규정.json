    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 사무관리규정 제16조 제2항의 규정에 의하여 국립생물자원관 소관업무의 전결 수준과 그 절차를 정함으로써 업무처리의 신속·효율화 및 권한과 책임의 합리적 배분을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립생물자원관위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 이 규정이 정한 위임전결사항은 다른 규칙에 특별한 규정이 있는 것을 제외하고는 이 규정이 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립생물자원관위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(전결사항) ① 부장, 과장 및 4·5급(연구관)의 위임전결사항은 별표와 같다.② 접수문서는 각과 위임전결수준에 의한 그 사무처리의 결재권자가 선결한다.③ 별표에 열거되지 아니한 사항은 별표의 위임전결사항중 유사한 사항에 준하여 전결한다. 다만, 전결자가 판단하기 어려운 사항은 차상급자의 결재를 받아야 한다.④ 전결자가 부재중(출장, 휴가, 교육 등)일 때에는 그 직무를 대리하는 자가 이를 대리 전결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립생물자원관위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "협조사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(협조사항) 위임전결사항 중 다른 부·과와 업무상 관련되는 사항은 협조를 받아야 하며, 협조를 받지 못한 경우에는 그 사유를 명시하여 관련부서를 모두 감독할 수 있는 차상급자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립생물자원관위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결자의 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(전결자의 책임) 위임전결사항에 대하여는 전결자가 관장에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립생물자원관위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(보고) 전결자는 필요하다고 인정할 때에는 그 전결 시행한 사항에 관하여 그 처리내용을 상급자에게 보고할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립생물자원관위임전결규정#JO0006"
      }
    ]
