  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 국립어린이청소년도서관 자문위원회(이하 \"위원회\"라 한다)의 구성 및 운영에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립어린이청소년도서관자문위원회규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "기능",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(기능) 위원회는 어린이청소년도서관의 발전에 관하여 국립어린이청소년도서관장의 자문에 응하고 발전방안을 건의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립어린이청소년도서관자문위원회규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(구성) ① 위원회는 위원장을 포함한 위원 15인 이내로 구성한다.② 위원장은 위원 중에서 호선하고, 위원회의 회의를 통할하며 그 의장이 된다.③ 위원은 도서관 및 관련분야의 학식과 경험이 풍부한 외부 전문가 중에서 국립어린이청소년도서관장이 위촉한다.④ 위원의 임기는 2년으로 하고 연임할 수 있다.⑤ 위원회의 회의 진행과 제반 사무를 담당하고, 회의록의 작성·유지를 위하여 간사 1인을 두되 간사는 기획협력과장이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립어린이청소년도서관자문위원회규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "회의",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(회의) ① 위원회의 회의는 위원장이 필요하다고 인정하거나, 관장 또는 위원 3분의 1 이상의 요청이 있을 때, 국립어린이청소년도서관장이 소집한다.② 위원회는 재적위원 과반수의 출석으로 개의하고, 출석위원 과반수의 찬성으로 의결한다.③ 위원장이 부득이한 사유로 인하여 직무를 수행할 수 없을 때에는 위원 중에서 최연장자가 그 직무를 대행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립어린이청소년도서관자문위원회규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "의견의 청취",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(의견의 청취) 위원회는 필요시 관계 인사를 초청하여 의견을 들을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립어린이청소년도서관자문위원회규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수당 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(수당 등) 위원회에 출석한 위원에게는 예산 및 기금운용계획 집행지침에 따라 수당과 여비를 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립어린이청소년도서관자문위원회규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "운영세칙",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(운영세칙) 이 규정에서 정하지 아니한 위원회 운영에 관하여 필요한 사항은 국립어린이청소년도서관장이 위원장과 협의하여 결정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립어린이청소년도서관자문위원회규정#JO0007"
      }
    ]
