    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 자문위원의 애경사에 관한 처리절차를 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의자문위원애경사처리에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "애경사",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(애경사) 이 규정에서 애경사라 함은 자문위원 본인 또는 배우자 및 직계존비속의 신상에 변동사항이 있음을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의자문위원애경사처리에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "애경사처리기준",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(애경사처리기준) 자문위원의 애경사처리는 사무처장이 정하는 별도기준에 의하여 실시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의자문위원애경사처리에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전달방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(전달방법) 경조사항이 확인되면 사무처장 또는 해당 시·도부의장이 방문 전달함을 원칙으로 하되, 필요시 해당 담당관 및 시·군·구협의회장이 대행할 수 있다",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의자문위원애경사처리에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "예외조치",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(예외조치) 자문위원 본인 신상에 관하여 각별한 관심을 가져야 할 중요한 아래 사항이 발생한 때는 사무처장은 예산범위내에서 현금 또는 물품으로 관심을 표명할 수 있다.  ①장기와병, 사업실패 등으로 생계가 극히 어려울 경우②불의의 사고 또는 천재지변으로 인명이나 재산상의 피해를 입었을때③기타 사무처장이 필요하다고 인정하는 경우",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의자문위원애경사처리에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "기록유지 및 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(기록유지 및 책임) 애경사 처리결과는 별지 서식에 따라 사무처장에게 보고하고 기록유지를 한다.",
        "enforcement_date": "",
        "relations": [],
