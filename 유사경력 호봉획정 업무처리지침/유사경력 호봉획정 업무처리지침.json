    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은 「공무원봉급 업무처리지침」(중앙인사위원회 예규 제157호, 2008.1.11)에서 소속장관이 정하거나 정할 수 있도록 되어 있는 유사경력인정환산율, 상당계급 기준 및 연구직 직렬별 해당학과를 명확히 규정함으로써 호봉획정 업무의 통일성과 공정성 확보를 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:유사경력호봉획정업무처리지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 이 지침은 환경부와 그 소속기관에 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:유사경력호봉획정업무처리지침#JO0002"
      },
