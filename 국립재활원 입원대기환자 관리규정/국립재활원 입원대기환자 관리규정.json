  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 국립재활원 재활병원에 입원신청한 환자에 대한 입원우선순위 등을 합리적으로 규정하기 위함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립재활원입원대기환자관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(정의) \"입원대기환자(이하 \"대기환자\"라 한다)\"라 함은 외래진료를 마치고 의사의 입원결정을 받아 입퇴원창구에 입원신청을 접수한 자를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립재활원입원대기환자관리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "입원우선순위",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(입원우선순위) ①대기환자의 입원 우선순위는 응급 및 협력병원 급성기환자, 의료급여환자, 보험환자 순으로 한다.<개정 2011.3.3.>②의료급여환자가 총 병상의 30%를 초과하더라도 신규환자는 건강보험환자에 우선하여 입원할 수 있다.  단, 재입원 신청환자는 건강보험환자와 동일하게 입원신청일 순으로 입원시킨다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립재활원입원대기환자관리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "재입원의 제한",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(재입원의 제한) 입원환자이었던 자가 퇴원 후 6월 이내에 재입원을 신청 한 때에는 병상수의 사정을 감안하여 재입원을 제한할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립재활원입원대기환자관리규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "기타",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(기타) 이 규정에 정하여지지 아니한 세부적인 사항은 원장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립재활원입원대기환자관리규정#JO0005"
      }
