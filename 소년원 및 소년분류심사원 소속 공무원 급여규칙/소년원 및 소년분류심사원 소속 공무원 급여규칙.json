  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 규칙은 소년원 및 소년분류심사원에서 근무하는 직원(이하 \"보도관\"이라 한다)에게 그 직무수행을 위하여 급여하는 물품(이하 \"급여품\"이라 한다)에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:보도관급여품규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "급여품",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (급여품) ①보도관에게는 예산의 범위안에서 보도관복제규칙에서 규정한 급여품을 현품으로 지급한다.②보도관에게 지급하는 급여품의 급여기준은 별표와 같다.③법무부장관은 특히 필요하다고 일정할 때에는 급여품의 종류·수량 및 사용기간을 변경할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:보도관급여품규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신규임용자 등에 대한 급여",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (신규임용자 등에 대한 급여) ①보도관이 신규임용 또는 승진임용된 때에는 임용 당시에 필요한 급여품만을 지급한다. 다만, 보도관이 급여시기를 지나서 임용된 때에는 다음 지급시기까지 급여품의 지급을 보류하거나 제5조의 규정에 의하여 반납된 급여품을 지급할 수 있다.②보도관이 사용기간내의 급여품을 분실 또는 훼손하였을 때에도 제1항의 단서와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:보도관급여품규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "급여품의 관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (급여품의 관리) ①급여품의 보수는 자기부담으로 한다.②보도관이 전보될 때에는 사용기간내의 모든 급여품을 지체없이 그 소속기관으로 관리전환을 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:보도관급여품규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "급여품의 반납",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (급여품의 반납) 보도관이 퇴직·휴직 또는 사망한 때에는 사용기간내의 모든 급여품을 반납하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:보도관급여품규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "급여품의 변상",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (급여품의 변상) ①소년원장 또는 소년분류심사원장(이하 \"원장등\"이라 한다)은 제3조제2항 및 제5조의 경우 급여품의 분실·훼손 또는 회수불능 원인이 보도관의 고의 또는 중대한 과실로 인한 것일 때에는 그 대가를 변상하게 하여야 한다.②원장등은 제1항의 규정에 의하여 변상금액을 징수하였을 때에는 지체없이 이를 국고에 납입하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:보도관급여품규칙#JO0006"
      }
    ]
  },
