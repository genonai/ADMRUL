 │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │만 게시 ┃\n┃  │(의무경찰순경)                  │    │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │        ┃\n┃  ├────────────────┼──┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┨\n┃  │재고품 현황                     │창고│  │  │  │  │?│  │  │  │  │  │?│  │  │  │  │?│  │  │  │  │        ┃\n┃  │총기 취급요령                   │보유│  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │        ┃\n┃  │                                │부서│  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │        ┃\n┃  ├────────────────┼──┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┨\n┃  │기타 특수사무실에               │관련│  │  │  │  │?│  │  │  │  │  │?│  │  │  │  │?│  │  │  │  │        ┃\n┃  │필요한 사항                     │부서│  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │        ┃\n┃  ├────────────────┼──┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┨\n┃  │표어 및 포스터                  │″  │  │  │  │  │  │?│  │  │  │  │  │?│  │  │  │  │?│  │  │?│게시판  ┃\n┃  │                                │    │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │복도현관┃\n┃  ├────────────────┼──┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┨\n┃  │경찰관계 공고                   │″  │  │  │  │  │  │?│  │  │  │  │  │?│  │  │  │  │?│  │  │?│        ┃\n┃  ├────────────────┼──┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┨\n┃  │현상수배 등                     │″  │  │  │  │  │  │?│  │  │  │  │  │?│  │  │  │  │?│  │  │?│        ┃\n┃  ├────────────────┼──┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┨\n┃  │교육에 필요한 어귀              │교육│  │  │  │  │  │?│  │  │  │  │  │?│  │  │  │  │?│  │  │?│        ┃\n┠─┴────────────────┼──┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┨\n┃규정에 없는 게시물                  │관련│  │  │  │  │?│  │  │  │  │  │?│  │  │  │  │?│  │  │  │  │        ┃\n┃의식개혁을 위한 다짐                │부서│  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │  │        ┃\n┗━━━━━━━━━━━━━━━━━━┷━━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━┷━━━━┛\n",
