    "articles": [
      {
        "article_no": "제2조",
        "article_title": "교육 대상자",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(교육 대상자)공증인 직무교육 대상자(이하 ‘교육 대상자’라고 한다)는 공증인법 제15조의10 규정에 따른 임명공증인과 법무부장관에게 신고된 인가공증인의 공증담당변호사로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공증인직무교육지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "교육시간",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(교육시간)교육 대상자에 대한 교육시간은 8시간 이상으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공증인직무교육지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "교육담당자",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(교육담당자)공증인에 대한 직무교육은 법무부 소속 검사 또는 대한공증인협회의 관련 임원, 기타 공증업무에 관한 학식과 경험이 풍부한 자로서 대한공증인협회의 장이 추천하는 자가 담당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공증인직무교육지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "교육내용",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(교육내용)공증인에 대한 직무교육은 공증인의 직무수행에 필요한 법률지식과 실무에 관한 교육을 그 내용으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공증인직무교육지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "교육일자 통지",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(교육일자 통지)법무부장관은 공증인법 제11조, 제15조의2 규정에 따른 공증인 임명 또는 인가시 교육대상자에게 지체 없이 교육일자를 지정하여 통지하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공증인직무교육지침#JO0006"
      }
    ]
