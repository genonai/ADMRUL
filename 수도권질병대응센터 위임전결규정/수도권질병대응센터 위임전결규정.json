    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 「행정 효율과 협업 촉진에 관한 규정」제10조 제2항의 규정에 의하여 수도권질병대응센터 제반 업무의 전결수준과 그 절차를 정함으로써 업무처리의 신속ㆍ효율 및 권한과 책임의 합리적 배분을 기함에 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:수도권질병대응센터위임전결규정#JO0001"
