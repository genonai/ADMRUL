  "body": {
    "format": "articles",
    "article_count": 11,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규칙은 지구대장, 파출소장(이하 \"지구대장 등\"이라 한다)이 관할구역내에서 경찰서장의 소관사무를 분장 처리함에 있어서 사용하는 직인에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "직인의 비치사용",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(직인의 비치사용) 지구대장 등은 다른 법령의 규정이 있는 경우를 제외하고는 이 규칙이 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "직인의 글씨 및 규격",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(직인의 글씨 및 규격) 지구대장 등의 직인의 글씨와 규격은 사무관리규정을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "직인조각",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(직인조각) 직인은 \"○○지구대장인\", \"○○파출소장인\"으로 새기되 그 인형은 정사각형으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "등록",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(등록) 직인은 제1호 서식에 의한 지구대장 등의 신청에 의하여 경찰서 관인대장에 등록해야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "관인대장",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(관인대장) 경찰서장은 제2호 서식에 의한 관인대장을 비치하여 직인을 새로 새기거나 폐기할 때마다 인영을 등록하고 필요한 사항을 정리하여 두어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "공고",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(공고) 직인을 새로 새기거나 폐기할 때에는 이를 공고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "직인의 폐기 및 재등록",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(직인의 폐기 및 재등록) ①직인의 마멸, 갱신 또는 기관의 폐지 등으로 직인을 폐기하고자 할 때에는 직인폐기신고서(서식 제1호)에 폐기직인을 첨부하여 관할 경찰서장에 지체없이 신고하고, 폐기할 직인은 사무관리규정에 따라 처리한다.②직인의 분실 또는 마멸 등으로 갱신할 필요가 있을 때에는 제5조의 규정에 의하여 재등록하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "직인의 사고보고 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(직인의 사고보고 등) 지구대장 등은 직인의 도난, 분실 또는 허위변조 등의 사고가 발생하였을 때에는 즉시 필요한 조치를 취하는 동시에 제3호 서식에 의한 직인사고보고서를 경찰서장에 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "관리자 및 관리방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(관리자 및 관리방법) ①직인은 지구대장 등이 관리한다.②직인을 사용하지 아니하는 때에는 항상 견고한 용기에 넣어 보관한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "직인의 날인",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(직인의 날인) 직인의 날인은 그 문서를 발행하는 기관의 명칭 끝자가 직인의 가운데 오도록 찍어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지구대장등직인관리규칙#JO0011"
      }
    ]
  },
