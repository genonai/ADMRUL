    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 고시는 「원양산업발전법」 제28조의3 및 같은 법 시행령 제16조의3 별표 3에 따라 안전관리책임자의 교육기준에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:안전관리책임자교육에관한고시#JO0001"
      },
