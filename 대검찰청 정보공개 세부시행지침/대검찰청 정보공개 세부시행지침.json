      {
        "article_no": "제8조",
        "article_title": "정보공개업무의 지도·감독",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(정보공개업무의 지도·감독) 각급 검찰청 및 지청의 장은 소속 직원이 이 지침을 준수하도록 지도·감독하여야 하며, 그밖에 정보공개의 확대를 위하여 필요한 조치를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:행정정보공개세부시행지침#JO0008"
