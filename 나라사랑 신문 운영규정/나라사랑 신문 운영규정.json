        "chapter": "",
        "chapter_path": "",
        "content": "제7조(구독료) 신문의 구독료는 무료로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:보훈신문운영규정#JO0007"
