            ┃\n┣━━┿━━━━━━━━━━━┿━━━━━━━━━━━━━━━━━━┿━━┿━━┿━━┿━━┿━━┿━━━━━━━━━┿━━━━━━━━━━┫\n┃5   │환경입지컨설팅제도    │현지확인 결과 보고                  │기안│    │○  │    │    │신설              │관련법 개정(‘12.7) ┃\n┃    │운영                  ├──────────────────┼──┼──┼──┼──┼──┤                  │                    ┃\n┃    │                      │검토의견 통보                       │기안│    │    │○  │    │                  │                    ┃\n┃    │                      ├──────────────────┼──┼──┼──┼──┼──┤                  │                    ┃\n┃    │                      │일반사업                            │기안│    │○  │    │    │                  │                    ┃\n┠──┼───────────┼──────────────────┼──┼──┼──┼──┼──┼─────────┤                    ┃\n┃9   │환경영향평가          │협의내용 반영 등 통보 접수          │기안│    │○  │    │    │세부사항 추가     │                    ┃\n┃    │협의사업장에 대한     │                                    │    │    │    │    │    │                  │                    ┃\n┃    │협의내용 관리?       │                                    │    │    │    │    │    │                  │                    ┃\n┃    │감독에 관한 사항      │                                    │    │    │    │    │    │                  │                    ┃\n┠──┼───────────┼──────────────────┼──┼──┼──┼──┼──┼─────────┤                    ┃\n┃10  │환경영향평가업자 등   │평가업자 지도감독 및 결과보고       │기안│    │    │○  │    │영향평가대행자    │                    ┃\n┃    │록?관리              ├─────────┬────────┼──┼──┼──┼──┼──┤→평가업자로 변경 │                    ┃\n┃    │                      │행정처분          │등록취소        │기안│    │    │    │○  │                  │                    ┃\n┃    │                      │                  ├────────┼──┼──┼──┼──┼──┤                  │                    ┃\n┃    │                      │                  │업무정지 및 경고│기안│    │    │○  │    │                  │                    ┃\n┃    │                      │                  ├────────┼──┼──┼──┼──┼──┤                  │                    ┃\n┃    │                      │                  │청    문        │기안│    │○  │    │    │                  │                    ┃\n┠──┼───────────┼─────────┼────────┼──┼──┼──┼──┼──┼─────────┤                    ┃\n┃11  │전략 및 소규모 환     │조사계획 수립     │기안            │    │    │○  │    │    │명칭 변경         │                    ┃\n┃    │경영향평가            ├─────────┼────────┼──┼──┼──┼──┼──┤(사전환경성검토   │                    ┃\n┃    │협의내용 관리?  감독 │협의내용 미이행   │공사중지요청    │기안│    │    │○  │    │→ 전략 및 소규모 │                    ┃\n┃    │에 관한 사항          │사업자에 대한 조치├────────┼──┼──┼──┼──┼──┤환경영향평가)     │                    ┃\n┃    │                      │                  │이행요청        │기안│    │    │○  │    │                  │                    ┃\n┃    │                      │                  ├────────┼──┼──┼──┼──┼──┤                  │                    ┃\n┃    │                      │                  │기타 일반사항   │기안│    │○  │    │    │                  │                    ┃\n┃    │                      ├─────────┴────────┼──┼──┼──┼──┼──┤                  │                    ┃\n┃    │                      │조사결과 보고                       │기안│    │○  │    │    │                  │                    ┃\n┗━━┷━━━━━━━━━━━┷━━━━━━━━━━━━━━━━━━┷━━┷━━┷━━┷━━┷━━┷━━━━━━━━━┷━━━━━━━━━━┛\n4. 유역관리국\n<유역계획과>\n┏━━┯━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━┯━━━━━━━━┯━━━━━┯━━━━━━━┓\n┃일련│업  무  내  용                                                  │담당자    │결재권자        │개정내용  │개정사유      ┃\n┃번호├──────────┬─────────────────────┼──┬──┼──┬──┬──┤          │              ┃\n┃    │단 위 업 무         │세부사항                                  │실무│계장│과장│국장│청장│          │              ┃\n┣━━┿━━━━━━━━━━┿━━━━━━━━━━━━━━━━━━━━━┿━━┿━━┿━━┿━━┿━━┿━━━━━┿━━━━━━━┫\n┃9   │환경보전 홍보 및 교 │기본계획 수립                             │기안│    │    │    │○  │업무 삭제 │기능이관      ┃\n┃    │육                  ├────────────────┬────┼──┼──┼──┼──┼──┤          │(유역계획과   ┃\n┃    │                    │세부홍보계획 수립               │중요사항│기안│    │    │○  │    │          │→환경관리과  ┃\n┃    │                    │  