    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 사무관리규정 제16조제2항 및 통계청 위임전결규정 제3조제4항의 규정에 의하여 통계교육원 제반업무에 관한 위임 및 전결사항과 그 절차를 정하여 업무처리의 신속을 기하고 권한과 책임의 소재를 명백히 함으로써 효율적인 업무수행을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 통계교육원의 위임 및 전결에 관한 사항은 다른 법규에 별도규정이 있는 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결권자",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(전결권자) 이 규정에서의 전결권자는 과장 및 담당으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(전결사항) 전결권자의 전결 사항은 [별표]와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결권의 상향 및 하향처리 금지",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(전결권의 상향 및 하향처리 금지) 전결권자는 당해 업무에 대한 처리권을 상향 또는 하향 전결하여 처리할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "전결권자의 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(전결권자의 책임) 전결 처리한 사항에 대하여는 그 전결권자가 원장에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "협의사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(협의사항) 전결사항 중 다른 과의 업무와 관련되는 사항은 관련과의 협조를 거쳐야 하며, 협조를 얻지 못하였을 때에는 원장의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(보고) 전결권자가 전결 시행한 사항 중 상급자가 알아야 한다고 인정되는 사항은 사후에 그 처리내용을 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "부재시 결재",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(부재시 결재) 결재권자가 휴가·출장 기타의 사유로 상당기간 부재중이거나 긴급한 문서로서 결재권자의 사정에 의하여 결재를 받을 수 없는 때에는 그 직무를 대리하는 자가 대결할 수 있되, 내용이 중요한 문서는 결재권자의 후열을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "기타사무",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(기타사무) 이 훈령에 규정하지 아니한 사항에 관하여는 이 훈령에 준하여 전결 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:통계교육원위임전결규정#JO0010"
      }
    ]
