    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규칙은 경찰청 의무실(이하 \"의무실\"이라 한다)의 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "의무실의 임무",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(의무실의 임무) 의무실은 다음 각호의 임무를 담당한다.1. 질병등 건강상태를 판별하기 위한 진찰 및 검사2. 경미한 환자의 치료 및 응급을 요하는 환자에 대한 응급처치3. 건강에 관한 상담",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "의무실 구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(의무실 구성) 의무실의 구성에 필요한 의사·약사·간호사는 경찰병원으로부터 파견받아 근무하도록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "진료대상",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(진료대상) 의무실에서 진료를 받을 수 있는 자는 다음 각호와 같다.1. 경찰공무원2. 전투경찰순경3. 경찰청에 근무하는 직원 및 용역업체 종사자4. 기타 의무실 운영위원회의 허가를 받은 자",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "의약품 등의 조달",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(의약품 등의 조달) 의무실 운영에 필요한 의료기재 및 의약품등은 경찰병원으로부터 조달한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "진료시간",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(진료시간) 진료시간은 일상 근무시간에 한함을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "환자의 진료",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(환자의 진료) ①의무실의 진료는 대상자의 요청에 의한다. 다만, 건강진단·전염병 예방주사 등 특히 필요한 경우에는 대상자의 요청없이 필요한 진료행위를 할 수 있다.②의무실의 진료만으로 치유가 어렵다고 판단되는 자는 경찰병원으로 후송하는 등 필요한 조치를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "의무실 운영위원회",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(의무실 운영위원회) 의무실 운영위원회 구성 및 운영에 관하여는 경찰청장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경찰청의무실운영규칙#JO0008"
      }
