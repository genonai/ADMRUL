  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 고시는 대한민국과 베트남사회주의공화국간 수출입 수산물의 안전성 확보를 위하여 2007년 11월 14일자로 개정하여 체결한 별첨『대한민국해양수산부국립수산물품질관리원과베트남사회주의공화국농업농촌개발부국립농림수산물품질보증국간수산물품질관리및식품안전에관한약정서』의 이행에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국과베트남사회주의공화국간수출입수산물의위생관리#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용대상",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용대상) 이 고시의 적용대상은 식용원료수산물과 식품첨가물이나 다른 원료를 사용하지 아니하고 절단·가열·숙성·건조 또는 염장·염수장 등과 같이 가공한 수산동·식물에 한한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국과베트남사회주의공화국간수출입수산물의위생관리#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "가공시설 등록 및 통보",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(가공시설 등록 및 통보) ① 양국은 수출수산물 가공시설의 위생관리상태가 상대국의 위생관리기준에 부합된 경우 자국의 검사기관에 등록한 후 등록된 가공시설(이하 \"등록시설\"이라 한다)의 명단을 상대국의 검사기관에 분기별로 통보하여야 한다.② 상대국으로 수출하고자 하는 수산물은 반드시 등록시설에서 생산·관리되어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국과베트남사회주의공화국간수출입수산물의위생관리#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "등록시설 위생관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(등록시설 위생관리) ① 양국의 검사기관은 제3조의 규정에 의한 등록시설에 대하여 상대국의 위생관리기준 준수 여부를 매년 조사·점검하여야 한다.② 양국의 검사기관은 제3조제1항의 규정에 의하여 등록된 자국의 등록시설에 대하여 상대국에서 위생관리기준 준수여부를 점검하는 것을 상호 보증하고 수출국은 수입국의 원활한 위생점검을 위해 수출국 수산물의 검사방법 및 모니터링 실적 등 위생점검에 대한 정보를 제공한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국과베트남사회주의공화국간수출입수산물의위생관리#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수출입수산물의 표시",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(수출입수산물의 표시) 양국은 수출수산물의 포장에는 지워지지 않는 방법으로 품명·국가명·등록시설의 명칭 및 등록번호를 인쇄하거나 표시하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국과베트남사회주의공화국간수출입수산물의위생관리#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "위생증명서 첨부",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(위생증명서 첨부) 양국의 검사기관은 수출수산물에 대하여 상대국의 법령 및 규정에 따라 검사를 실시하고, 검사결과 기준에 적합한 경우 별지 서식의 위생증명서를 첨부토록 하여야 한다.1. 국립수산물품질관리원 위생증명서 : 별지 12. 국립농림수산물품질보증국 검사·검역증명서 : 별지 2",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국과베트남사회주의공화국간수출입수산물의위생관리#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수산물 수입의 잠정 중단조치",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(수산물 수입의 잠정 중단조치) 양국은 자국으로 수입된 수산물에 위생 및 안전에 관한 문제가 발생하는 경우에는 신속히 상대국에 통보하고, 재발 방지를 위하여 원인조사를 위한 정보를 제공하여야 한다. 이 경우 수입국은 상대국의 당해 등록시설에 대하여 문제가 완전히 해결될 때까지 수입을 잠정 중단할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국과베트남사회주의공화국간수출입수산물의위생관리#JO0007"
      }
    ]
  },
