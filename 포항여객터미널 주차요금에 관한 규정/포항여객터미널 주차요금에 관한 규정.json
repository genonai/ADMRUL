        "chapter": "",
        "chapter_path": "",
        "content": "제2조(주차장운영시간) 주차장 운영시간은 24시간으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:포항여객터미널주차요금에관한규정#JO0002"
