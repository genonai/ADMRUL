    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 고시는 농수산물품질관리법 제79조 및 동법시행규칙 제94조에 따른 농산물의 품목별 포장단위당 무게, 포장재 규격 및 포장방법, 품위검사규격 등에 관하여 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:농산물검사기준#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "검사규격",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(검사규격) ①농산물의 품목별 포장단위당 무게는 별표1과 같다.②농산물의 포장재 규격 및 포장방법은 별표2와 같다.③농산물의 품위 검사규격은 별표3과 같다.④별표3 중 표준품은 국립농산물품질관리원장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:농산물검사기준#JO0002"
      }
    ]
