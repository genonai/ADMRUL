    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 고시는 「1979년 해상 수색 및 구조에 관한 국제협약」 및 「1944년 국제민간항공협약」 상의 해상구조조정본부 및 해상구조조정지부를 지정하여 수색 및 구조 구역내에서 수색 및 구조업무의 효율적인 조직화를 촉진하고, 선박위치통보에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해상구조조정본부지정등에관한고시#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "해상구조조정본부 등의 지정",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(해상구조조정본부 등의 지정) 해상구조조정본부(이하 \"구조조정본부\"라 한다)는 서해지방해양경찰청, 남해지방해양경찰청, 동해지방해양경찰청, 인천해양경찰서, 제주해양경찰서로 하고 해상구조조정지부(이하 \"구조조정지부\"라 한다)는 인천해양경찰서와 제주해양경찰서를 제외한 해양경찰서로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해상구조조정본부지정등에관한고시#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구조조정본부 및 구조조정지부의 관할해역",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(구조조정본부 및 구조조정지부의 관할해역) 구조조정본부의 관할해역은 별표 1에 따른 해역으로 하고, 구조조정지부의 관할해역은 해당 경찰서의 관할해역으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해상구조조정본부지정등에관한고시#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "선박위치통보 해역 및 통보",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(선박위치통보 해역 및 통보) 「수난구호법」제18조의 선박위치통보(이하 \"선위통보\"라 한다) 해역은 「수난구호법시행규칙」별표에 의한 해역으로 하고, 광역구조본부의 장 및 구조조정본부장에게 통보할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해상구조조정본부지정등에관한고시#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "선위통보용 주파수",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(선위통보용 주파수) 선위통보 시 통신방식에 따른 호출용, 통신용 주파수는 별표 2에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해상구조조정본부지정등에관한고시#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "구조조정본부의 호출명칭 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(구조조정본부의 호출명칭 등) 무선전화(VHF), 무선전화(SSB), NBDP(MF/HF)를 이용한 선위통보 시 사용할 구조조정본부 호출명칭 및 식별번호는 별표 3에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해상구조조정본부지정등에관한고시#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "그 밖의 방법에 따른 선위통보 연락처",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(그 밖의 방법에 따른 선위통보 연락처) INMARSAT-전화, FAX, TELEX를 이용한 선위통보 시 연락처는 별표 4에 따른다.",
        "enforcement_date": "",
