  "body": {
    "format": "articles",
    "article_count": 13,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규칙은 대한민국역사박물관의 방호에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(정의) ① ‘경비원’ 이라 함은 청사 방호 및 경비 업무 등을 담당하는 외부 용역업체의 직원을 말한다.② ‘보안관리실’이라 함은 청사 방호 및 경비업무 등의 수행을 위하여 경비원이 상시 근무하는 사무공간을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "임무",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(임무) 경비원은 다음 각 호의 업무를 담당한다.1. 청사와 전시실, 유물창고 및 소장유물의 방호2. 출입자 및 차량의 통제3. 화재 및 도난방지4. 야간근무 및 순찰5. 관람객 안전 및 질서유지",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "조직",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(조직) ① 경비원을 지휘·감독하기 위하여 운영지원과장 승인에 따라 경비반장 1인과 부경비반장 1인을 둘 수 있다.② 방호근무의 원활을 기하기 위하여 전시실 근무, 외곽근무 및 야간근무의 감독을 위한 별도의 책임자를 둘 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "경비반장",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(경비반장) ① 경비반장은 방호임무사항 수행을 감독하고 화재와 도난예방을 위한 청사의 경비순찰을 담당한다.② 부경비반장은 경비반장을 보좌하고 경비반장 유고시 그 직무를 대행 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "근무요령",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(근무요령) 경비원은 근무명령에 따라 주출입구, 부출입구, 전시실 근무 및 야외 순찰 근무를 원칙으로 하며, 근무시간 중 근무지를 이탈하거나 음주를 하여서는 아니 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "배치",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(배치) 경비원의 근무배치는 경비반장이 정하되 운영지원과장의 사전승인을 얻어 배치토록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "의무",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(의무) ① 경비원은 소방규칙, 당직 및 비상근무규정, 출입증관리지침, 전시실 관리지침 등을 숙지하여 근무에 철저를 기한다.② 경비원은 임무수행과정에서 관람객 및 방문객 등에 대하여 친절하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "규정 등 비치",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(규정 등 비치) 경비원은 보안관리실에 근무명령서 및 제 규정철을 비치하고 활용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "근무시간 등 변경",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(근무시간 등 변경) 근무시간 및 근무지를 변경하고자 할 때는 사전에 운영지원과장의 승인을 얻어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "인계인수",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(인계인수) 근무자가 근무를 교대할 때에는 다음 각 호의 사항을 인계인수한다.1. 지시받은 사항2. 근무 중 발생한 특이사항3. 기타 각종 일지 및 기록사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "복장",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(복장) 경비원은 근무시간 중 지정복을 착용하고 근무하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "순찰",
        "chapter": "",
        "chapter_path": "",
        "content": "제13조(순찰) 순찰을 담당하는 경비원은 2시간 간격으로 순찰을 하고 이상 유무를 확인하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관방호규칙#JO0013"
      }
    ]
  },
