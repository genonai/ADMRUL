    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 「자동차관리법 시행규칙」 제133조제6항에 따라 표준정비시간의 공개, 주요 정비 작업에 대한 시간당 공임 및 표준정비시간의 게시 등에 관한 세부사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:표준정비시간의공개방법등에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 「자동차관리법」 제58조제4항에 따라 공개되는 시간당 공임 및 표준정비시간은 수리비 투명화 및 소비자의 알권리를 보장하기 위한 것으로 다른 법률에 특별한 규정이 있는 경우를 제외하고는 이 규정을 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:표준정비시간의공개방법등에관한규정#JO0002"
