        "chapter": "",
        "chapter_path": "",
        "content": "제2조(야생화된 동물) 야생동물 및 그 알·새끼·집에 피해를 주는 들고양이를 야생화된 동물로 지정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:야생화된동물의지정#JO0002"
      },
