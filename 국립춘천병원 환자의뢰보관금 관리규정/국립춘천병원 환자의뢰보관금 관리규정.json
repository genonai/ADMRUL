  "body": {
    "format": "articles",
    "article_count": 13,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 환자 간식 보관금(이하 \"보관금\"이라 한다)은 우리원에 재원중인 환자 또는 보호자의 원에 의해 맡겨진 보관금으로 환자의 생활필수품 구입, 간식 및 외출 ㆍ 외박비용을 적정하게 관리 운영함으로써 환자들의 원내 생활 편의 도모와 조속한 치유를 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "관리부서",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(관리부서) 보관금의 관리는 간호과(외래)에서 관리 ㆍ 운영한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "입금주체",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(입금주체) 보관금은 환자 ㆍ 보호자 또는 입금을 희망하는 제 3자가 의뢰할 수 있다",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "입금시기",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(입금시기) 보관금은 환자 입원기간에만 입금할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(사용범위) 보관금은 잔액 범위 내에서 사용가능하며 잔액을 초과하여 사용할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "영수증 발급",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(영수증 발급) 환자 또는 보호자(제 3자 포함)로부터 보관금을 수령한 경우에는 영수증을 발행(전산발행 포함)하여야 하며, 단 업무용계좌에 송금한 경우는 예외로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "금융기관 예치",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(금융기관 예치) 당일 수입금은 근무시간 종료 후 금고에 보관한 후 익일 은행영업일에 금융기관 관리계좌에 입금한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "운용자금",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(운용자금) ① 원활한 업무처리를 위하여 1일 가용자금을 200만원 한도의 현금운용 할 수 있다.② 보관금 수불상 지장 없는 범위내에서는 현금 및 보통예금으로 관리하며, 일정금액이상인 경우 정기예금으로 안전하게 보관할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "이자처리",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(이자처리) 보관금에서 발생하는 이자는 ‘재원환자 복지비용’으로 사용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "수불대장",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(수불대장) 보관금 수불사항은 기록관리(EMR)하여야 하며 수불일지를 작성하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "잔액처리",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(잔액처리) ① 퇴원시 보관금 잔액은 환자 또는 보호자에게 반환해야 한다.② 환자가 외출 ㆍ 외박 등 내원하지 않아 잔액을 수령하지 않는 경우에는 다음과 같이 처리한다.1. 체납 진료비가 있는 경우에는 진료비정산에 우선 충당 할 수 있다.1. 보관금 관리 담당자는 환자 퇴원시에 간식보관금 사용잔액을 환불해 갈 수 있도록 적극적인 방안을 강구하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "정보공개",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(정보공개) 환자 또는 보호자가 보관금 사용내역의 공개를 요구하면 해당환자에 한하여 공개할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "기타",
        "chapter": "",
        "chapter_path": "",
        "content": "제13조(기타) 이 규정은 1998년부터 5월 28일부터 소급 적용하며, 제반 산정기간일은 이 규정의 시행일부터 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원환자간식보관금관리규정#JO0013"
      }
    ]
