    "articles": [
      {
        "article_no": "제1조",
        "article_title": "위원회의 설치",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (위원회의 설치) 국립부곡병원 보안관련 사항을 심의·의결하기 위하여 보안심사위원회(이하 \"위원회”라 한다)를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원보안심사위원회규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (구성) ①위원회는 위원장을 포함한 5인 이상 7인 이하의 위원으로 구성한다.②위원장은 원장이 되고, 위원은 과장 중에서 회의 개최시마다 원장이 지명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원보안심사위원회규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "간사",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (간사) ①위원회는 간사 1인을 두되, 간사는 보안담당자로 한다.②간사는 위원회에 관한 기록 및 기타 서류의 작성과 보관에 관한 사무를 담당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원보안심사위원회규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위원장의 권한",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (위원장의 권한) ①위원장은 회의를 소집하고 표결권을 가지며, 가부동수일 때에는 결정권을 가진다.②위원장유고시에는 서무과장이 그 직무를 대행한다.③필요하다고 인정될 때에는 관계공무원 등을 회의에 출석시켜 의견을 진술하게 할 수 있다.<신설>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원보안심사위원회규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "심의사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (심의사항) ①신원특이자 심사에 관한 사항②연간 보안업무시행계획의 수립에 관한 사항③임시직원 및 민간인에 대한 비밀취급인가적부심에 대한 사항④기타 보안업무수행에 필요한 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원보안심사위원회규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "의안제출",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (의안제출) 위원회의 위원 및 간사는 의안의 제출권을 가진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원보안심사위원회규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "의안의 결정",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조 (의안의 결정) 위원회의 의사는 재적위원 과반수 출석과 출석위원 과반수의 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원보안심사위원회규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "보칙",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조 (보칙) 이 규정에 규정된 이외의 필요한 사항은 위원회에서 정한다.",
