    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 행정업무의 효율적 운영에 관한 규정 제10조 제2항에 의거 해양수산인재개발원 소관업무를 신속하고 책임있게 처리하기 위하여 권한 위임에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용) 해양수산인재개발원의 위임전결사항은 따로 규정이 있는 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "용어의 정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(용어의 정의) 사무내용 중 사용하는 용어의 뜻은 다음의 각호와 같다.1. \"중요사항\"이란 사무의 기본이 되거나 비중이 큰 내용을 말한다.2. \"일반사항\"이라 함은 관례적이거나 사무집행적인 내용을 말한다.3. \"경미사항\"은 업무의 지엽적인 내용 또는 중요사항 및 일반사항에 부수되는 내용을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(전결사항) ①교육지원과장 및 교육운영과장 그리고 담당공무원의 전결사항은 별표와 같다.②별표에 열거되지 아니한 사항은 별표의 전결사무와 비교하여 유사한 사항에 준하여 전결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "협의사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(협의사항) 전결사항 중 타 과와 관련된 사항은 관련 과장의 협의를 거쳐야 하며, 타 과와 합의하지 못한 때에는 원장의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "전결의 특례",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(전결의 특례) 원장이 특히 필요하다고 인정하여 지시하는 사항에 대하여는 이 규정에 의한 전결사항에도 불구하고,그 지시에 따라 전결권자를 별도로 지정하여 처리할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "전결권자의 부재",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(전결권자의 부재) 전결권자가 출장, 휴가, 사고 등 기타 사정에 의하여 결재를 할 수 없을 때에는 \"직무대리규정\" 및 \"행정업무의 효율적인 운영에 관한 규정\"에 의하여 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "전결권자의 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(전결권자의 책임) 위임전결사항에 대하여는 그 전결권자가 원장에  대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(보고) 전결권자가 전결한 사항 중 상급자가 알아야 한다고 판단되는 사항은 사후에 그 처리내용을 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산인재개발원위임전결규정#JO0009"
      }
    ]
  },
