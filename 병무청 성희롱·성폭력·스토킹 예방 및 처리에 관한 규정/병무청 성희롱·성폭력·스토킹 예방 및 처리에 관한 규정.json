      {
        "article_no": "제14조",
        "article_title": "위원회의 임무",
        "chapter": "",
        "chapter_path": "",
        "content": "제14조(위원회의 임무) 병무청장 및 그 소속기관의 장이 회부한 성희롱 관련사항을 심의한다.[본조개정 ’06.10.27]",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:병무청성희롱예방규정#JO0014"
