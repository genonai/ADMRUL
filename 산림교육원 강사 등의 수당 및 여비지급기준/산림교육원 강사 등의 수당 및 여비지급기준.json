  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 기준은 산림교육원 강사수당과 강사여비에 대한 합리적인 지급기준을 마련하여 우수 강사진 확보 및 원활한 교육운영을 기하는데 그 목적이 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림교육원강사등의수당및여비지급기준#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수당 지급",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(수당 지급) ①강사수당은 산림교육원에서 운영하는 교육훈련에 출강하여 강의한 강사에 대하여 지급한다.②강사 외에 교육훈련에 참여하는 퍼실리테이터 등과 산림교육원에서 개최하는 심의회, 협의회, 세미나 등에 참석하는 자에게 강사수당에 준하여 수당을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림교육원강사등의수당및여비지급기준#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "여비 지급",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(여비 지급) ①강사여비는 공무원여비규정에 따라 산림교육원에서 운영하는 교육훈련에 출강하여 강의한 강사에게 지급함을 원칙으로 한다.②제1항의 규정에 따른 강사 외에 교육훈련에 참여하는 퍼실리테이터 등과 산림교육원에서 개최하는 심의회, 협의회, 세미나 등에 참석하는 자에게 강사에 준하여 여비를 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림교육원강사등의수당및여비지급기준#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "지급기준",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(지급기준) 강사수당 및 여비 지급기준은 매년 예산을 감안하여 산림교육원장이 별도로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림교육원강사등의수당및여비지급기준#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "강사수당 운영",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(강사수당 운영) ①우수강사진 확보를 위하여 다른 교육 기관에 상응하는 강사수당을 산정한다.②강사수당은 일자별 산정방식을 원칙으로 하되, 동일날짜에 2개 교육과정 이상 분반하여 강의할 경우에도 모두 지급한다.③교육과정이 다르지만 동일날짜에 합반하여 강의할 경우에는 1개 과정만 강사수당을 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림교육원강사등의수당및여비지급기준#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "강의시간 산출",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(강의시간 산출) 강의시간은 아래와 같이 계산한다.1. 1시간 이하 : 1시간2. 1시간 초과 ~ 2시간 이하 : 2시간3. 2시간 초과 ~ 3시간 이하 : 3시간4. 3시간 초과 ~ 4시간 이하 : 4시간으로 수당지급시간 산출",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림교육원강사등의수당및여비지급기준#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "보조강사 운영",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(보조강사 운영) ①보조강사라 함은 주강사의 교육진행과 학습효과를 높이기 위하여 동작의 시범 및 실습 등을 직접 시연함으로써 주강사의 교육진행에 보조적인 역할을 직접 담당하는 자를 말한다.②주강사의 교육진행 목적상 보조강사가 꼭 필요한 경우에 한하여 최소한의 인원으로 한정하여야 하며, 최대 2인까지만 강사수당을 지급함을 원칙으로 한다.③주강사는 보조강사가 필요한 경우 사전에 담당부서와 협의하여야 한다.④주강사의 교육진행을 높이기 위해 강의매체(PPT 등)의 조작 등을 보조하는 행위는 보조강사로 인정할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림교육원강사등의수당및여비지급기준#JO0007"
      }
    ]
