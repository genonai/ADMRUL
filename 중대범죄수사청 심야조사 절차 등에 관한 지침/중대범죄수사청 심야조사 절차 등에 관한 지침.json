      "content": "<별지 제3호>\n┏━━┯━━━━━━┯━━━━━━┯━━━━━━━┯━━━━━┯━━━━━┯━━━━━┯━━━━━━━━━━━━┯━━┯━━━━━┓\n┃연번│허가        │허가        │사건번호      │죄     명 │피조사자  │주임수사관│심야조사                │허가│적정성    ┃\n┃    │신청일      │대상일      │              │          │(신분표시)│          │필요성                  │여부│여부      ┃\n┣━━┿━━━━━━┿━━━━━━┿━━━━━━━┿━━━━━┿━━━━━┿━━━━━┿━━━━━━━━━━━━┿━━┿━━━━━┫\n┃1   │2026.00.00. │2026.00.00. │2026 - 0000호 │          │○○○    │          │피의자 요청             │허가│적정      ┃\n┃    │            │            │              │          │(피의자)  │          │2026.00.00. 국외출국    │    │          ┃\n┃    │            │            │              │          │          │          │ (변호인 동의 ○)       │    │          ┃\n┠──┼──────┼──────┼───────┼─────┼─────┼─────┼────────────┼──┼─────┨\n┃2   │2026.00.00. │2026.00.00. │2026 - 0000호 │          │○○○    │          │공소시효 임박           │허가│부적정    ┃\n┃    │            │            │              │          │(피의자)  │          │ (공소시효 만료일 :    )│    │(사유 및  ┃\n┃    │            │            │              │          │          │          │                        │    │조치)     ┃\n┠──┼──────┼──────┼───────┼─────┼─────┼─────┼────────────┼──┼─────┨\n┃    │            │            │              │          │          │          │                        │    │          ┃\n┠──┼──────┼──────┼───────┼─────┼─────┼─────┼────────────┼──┼─────┨\n┃    │            │            │              │          │          │          │                        │    │          ┃\n┠──┼──────┼──────┼───────┼─────┼─────┼─────┼────────────┼──┼─────┨\n┃    │            │            │              │          │          │          │                        │    │          ┃\n┠──┼──────┼──────┼───────┼─────┼─────┼─────┼────────────┼──┼─────┨\n┃    │            │            │              │          │          │          │                        │    │          ┃\n┗━━┷━━━━━━┷━━━━━━┷━━━━━━━┷━━━━━┷━━━━━┷━━━━━┷━━━━━━━━━━━━┷━━┷━━━━━┛\n심야조사 허가대장",
