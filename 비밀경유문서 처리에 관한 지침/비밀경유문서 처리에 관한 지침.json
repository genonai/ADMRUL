    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 본 예규는 보안업무규정(대통령령 제10478호),보안업무규정시행규칙(대통령훈령 제46호),사무관리규정시행규칙(총리령 제395호) 및외무부보안규정시행세칙(외무부훈령 제199호)에 따라실시되고 있는 경유문서의 수발중 비밀문서의 처리에 관하여 필요한 세부사항을규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:비밀경유문서처리에관한지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "비밀경유문서의 정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (비밀경유문서의 정의)비밀경유문서란 재외공관의 장이 외무부장관을 경유하여 외무부장관 이외의행정각부의 장에게로 발송하는 비밀문서와 외무부장관 이외의 행정각부의 장이외무부장관을 경유하여 재외공관의 장에게로 발송하는 비밀문서를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:비밀경유문서처리에관한지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "문서의 접수",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (문서의 접수) ①재외공관의 장이 외교행낭의 수발계통에 의해 발송한 비밀경유문서와 외무부장관이외의 행정각부의 장이 문서수발계통에 의해 발송한 비밀경유문서는 문서담당관실비밀문서전담직원에게 접수된다.②문서담당관실 비밀문서전담직원은 접수된 비밀경유문서를 지체없이 각실·국주무과(취급자)에 인계하고 접수대장 수령자란에 수령자의 성명을 기입하고날인(서명)을 받아야 한다.③각실·국 주무과(취급자)는 문서담당관실로부터 수령한 비밀경유문서를 즉시처리과(취급자)에 인계하고 비밀경유문서접수대장 수령자란에 수령자의 성명을기입하고 날인(서명)을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:비밀경유문서처리에관한지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "문서의 발송",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (문서의 발송)비밀경유문서를 수령한 처리과는 비밀경유문서의 경유 표시인의 경유란에 결재권자및 그 직근 하급자의 서명을 받아 문서담당관실로 보내야 하며, 문서담당관은 두문의경유기관명에 관인을 찍고 경유표시인의 적당한 여백에 문서통제인을 찍어재외공관의 장이 수신기관일 경우에는 외교행낭의 수발계통에 의해,외무부장관 이외의 행정각부의 장이 수신기관일 경우에는 문서수발계통에 의해 각각수신기관에 발송한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:비밀경유문서처리에관한지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수발사항의 기록",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (수발사항의 기록)각 실·국의 주무과는별지 제1호서식의 비밀경유문서접수대장을 비치하여 문서의 접수와 발송사항을 기록·유지하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:비밀경유문서처리에관한지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수발사항의 점검",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (수발사항의 점검)문서담당관은 분기 1회 문서담당관실의 접수대장과 각 실·국 주무과의 비밀경유문서접수대장의 기록내용을 점검하여야 한다.부칙이 예규는 발령한 날부터 시행한다.",
