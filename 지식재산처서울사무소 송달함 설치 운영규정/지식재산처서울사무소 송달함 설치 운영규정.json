    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 특허청서울사무소 송달함(이하 \"송달함\"이라 한다)의 설치운영에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "송달함의 설치장소",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(송달함의 설치장소) 송달함은 이용자가 가장 편리하게 이용할 수 있는 위치에 설치·운영한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "관장부서 및 요원의 배치",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(관장부서 및 요원의 배치) ①송달함은 관리과장이 관장한다.②송달함의 운영을 위하여 직원 2명을 배치한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "취급업무의 범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(취급업무의 범위) 송달함을 통한 송달서류는 다음과 같다.1. 출원, 심사, 등록, 심판에 관한 중간서류와 완결서류2. 기타 특허관계서류",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "이용대상자",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(이용대상자) ①송달함의 이용대상자는 서울 또는 재경지역에서 영업중인 변리사 또는 유관단체로서 특허청서울사무소에 송달함 이용신청서를 제출한 자로 한다.②송달함 이용신청시에는 별지1호 서식에 의한 송달함 이용신청서에 별지 2호 서식에 의한 각서를 첨부하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "이용시간",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(이용시간) 송달함의 이용시간은 공무원복무규정에서 정하는 근무시간내로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "장부의 비치 및 수령인 날인",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(장부의 비치 및 수령인 날인) ①송달함 설치장소에는 다음과 같은 대장을 비치하여야 하며 수령인으로 하여금 수령일자 및 성명을 기입케하고 등록된 인감도장으로 확인날인을 받아두어야 한다.1. 문서교부대장(별지 제3호 서식)2. 등기우편물 발송대장(별지 제4호 서식)②제1항의 수령인이 변리사 본인이 아닌 경우에는 변리사의 인감도장과 대행자의 인장을 함께 날인토록 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "전화독촉등",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(전화독촉등) 송달함실 근무자는 특허청 해당부서로부터 송달함 이용서류를 이송받은 날로부터 5일이 경과되어도 당해 변리사 또는 유관단체에서 이를 수령해 가지 아니할 경우에는 전화로 독촉하여야 하며, 1주일이 경과한 후에는 이를 등기우편으로 발송하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특허청서울사무소송달함설치운영규정#JO0008"
      }
    ]
  },
