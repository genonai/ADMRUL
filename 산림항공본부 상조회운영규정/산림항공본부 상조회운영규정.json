      {
        "article_no": "제1조",
        "article_title": "명칭",
        "chapter": "제1장 총칙",
        "chapter_path": "제1장 총칙",
        "content": "제1조 (명칭) 본 회는 산림항공본부 직장상조회(이하 \"상조회\"라 한다)라 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림항공본부상조회운영규정#JO0001"
      },
      {
