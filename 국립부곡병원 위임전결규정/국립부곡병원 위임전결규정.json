    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 규정은 사무관리규정 제16조제2항의 규정에 의하여 국립부곡병원 제반업무의 전결수준과 그 절차를 정함으로써 업무처리의 신속·효율화 및 권한과 책임의 합리적 배분을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (적용범위) 국립부곡병원위임전결사항은 따로 법령에 규정되어 있는 것을 제외하고는 이 규정이 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (전결사항) ①의료부장·서무과장 및 의료부 각 과장의 위임전결사항은 별표와 같다.②별표에 열거되지 아니한 사항은 별표의 위임전결사항 중 유사한 사항에 준하여 전결한다. 다만, 전결권자가 판단하기 어려운 사항은 차상급자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "협의",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (협의) 위임전결사항 중 다른 부·과장과 업무상 관련되는 사항은 협의를 받아야 하고 협의를 보지 못하였을 때에는 관련 부서를 모두 감독할 수 있는 차상급자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결권자의 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (전결권자의 책임) 전결처리 한 사항에 대하여는 그 전결권자가 원장에 대하여 책임을 지며, 상급자는 하급자의 전결사항에 관하여는 제4조의 경우를 제외하고는 결재를 요구할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (보고) 전결권자는 필요하다고 인정할 때에는 그가 전결시행 한 사항에 관하여 그 처리내용을 상급자에게 보고할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립부곡병원위임전결규정#JO0006"
      }
    ]
