    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 훈령은 국가공무원 파견정원의 동결과 감축관리에 관한 사항을 규정함으로써 인사관리의 효율화를 기하고 행정의 생산성을 높이는 것을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공무원파견정원관리지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "파견정원 동결원칙",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (파견정원 동결원칙) 공무원 파견 총 정원은 1996년 12월말 기준으로 결원 보충이 승인되거나 계획된 직급별 파견인원으로 한다. 다만, 법령에 의한 한시적국가사업등을 위하여 특별히 총 파견정원을 조정할 필요가 있는 경우에는 국무총리의 승인을 얻어 이를 조정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공무원파견정원관리지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "파견정원 동결방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (파견정원 동결방법) 신규사업에 따른 파견 수요가 있는 경우 특별한 사정이 없는 한 기존 파견인력의 복귀등 파견정원 감축조치후 상계하여 파견한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공무원파견정원관리지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "파견정원의 감축",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (파견정원의 감축) ①직무파견정원은 파견의 필요성·파견기간등을 고려하여 별표와<%생략:별표0%> 같이 연차적으로 이를 감축한다.②직무파견정원이 특별히 과다한 부처에 대하여는 총무처장관이 당해 부처와 협의하여 별표에<%생략:별표0%> 의한 감축외에 추가로 특별감축계획을 수립하여 연차적으로 감축할 수 있다.③5급이상 공무원의 교육파견정원은 소속기관의 5급이상 총 정원의 10%를 초과할 수 없으며, 이를 초과하는 부처는 총무처장관과 협의하여 단계적으로 감축하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공무원파견정원관리지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "파견정원의 관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (파견정원의 관리) ①파견을 받을 기관의 장은 신규사업에 따른 파견수요가 5명이상 있는 경우 사전에 총무처장관과 파견인원·파견자 직급·파견자 소속부처등을 협의하여야 한다.②파견자는 파견목적의 효율적 달성과 업무발전을 위하여 특별한 사정이 없는한 파견복귀후 상당기간 관련분야에서 근무가 가능하며 다른 기관에 파견근무중에 있지 아니한 자중에서 선발하여야 한다.③파견목적 달성전에 파견기간중 파견자를 조기 복귀시키는 것을 지양한다.④파견복귀자는 파견목적과 관련된 직무분야에 우선 보직하도록 하되, 파견복귀후 소속기관에서 보직을 부여하기가 곤란한 경우 총무처장관은 부처별 결원발생 상황에 따라 유관부처 전출을 권장할 수 있다.⑤파견을 받은 기관의 장은 파견자가 성실히 업무에 전념할 수 있도록 복무관리에 만전을 기하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공무원파견정원관리지침#JO0005"
