  "body": {
    "format": "articles",
    "article_count": 11,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 지침은 국립수산과학원 연구소 및 센터에서 시험연구사업 수행중 생산되는 담수산 유용수산 종묘의 분양 및 방류업무를 효율적으로 수행함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "용어의 정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (용어의 정의) 이 지침에서 담수산 유용수산종묘라 함은 유용 담수산생물(어류, 패류, 갑각류, 자라 등)을 대상으로 시험 생산한 어린 생물 및 수정란을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "분양의 구분",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (분양의 구분) 종묘의 분양은 유상분양과 무상분양으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "분양물량 및 방류량의 결정",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (분양물량 및 방류량의 결정) 연구소장 및 센터장(이하 \"소장\"이라 한다)은 생산된 종묘량을 감안하여 유상·무상 분양량 및 방류량을 결정하고, 그 결과를 국립수산과학원장(이하 \"원장\"이라 한다)에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "분양신청",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (분양신청) 유상 및 무상종묘 분양을 희망하는 자는 별지 제1호서식의 분양 신청서를 소장에게 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "유상분양",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (유상분양) ⓛ소장은 접수된 분양신청자중 다음 각호의 우선순위에 따라 분양 대상자를 선정하여야 하여 분양단가는 시세에 따른다.1. 자연부락단위 공동사업자2. 어업인후계자3. 정부지원 투·융자 사업자4. 일반 양식업자②종묘분양 결정 통보서를 받은 자는 종묘수령과 동시에 대금을 납부하여야 하며 지정된 기간내에 종묘를 인수치 않을 때에는 분양 의사가 없는 것으로 간주한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "무상분양",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조 (무상분양) ①무상분양 우선순위는 시험연구기관, 공공기관, 공익을 위한 법인체 순으로 한다.②위 ①항 이외의 무상분양이 필요하다고 인정될 때는 소장이 원장의 승인을 얻은 후 분양한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "분양대상자 선정 및 분양량 결정",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조 (분양대상자 선정 및 분양량 결정) ①소장은 제5조의 분양신청을 받아 품종멸 총분양물량, 분양목적 및 분양신청자수를 감안 분양대상자를 선정하고 분양량을 적정하게 배분하여야 한다.②소장은 분양대상자에게 분양품종, 수량 및 단가를 별지 제2호서식에 의거 신청자에게 통보한다. 단, 포장 및 수송에 따른 경비는 분양대상자 부담으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "종묘방류",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조 (종묘방류) 소장은 자원조성을 위하여 필요하다고 인정되는 공공수면에 종묘를 방류할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "사후관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조 (사후관리) 시험연구용으로 종묘를 분양받은 자는 시험완료 후 별지 제3호서식에 의한 시험결과 보고서를 소장에게 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조 (보고) 소장은 분양 및 방류 완료 후 결과를 원장에게 보고하고 원장은 이를 종합하여 농림수산식품부장관에게 보고하여야 한다. <개정 2008.3.25>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원담수산종묘분양및방류지침#JO0011"
      }
    ]
  },
