  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규칙은 사무관리규정에 의거 조달청 및 그 산하기관에서 사용하는 관인(기관장의 보조기관과 각종 위원회의 관인을 포함한다)의 비치 및 보관과 기타 필요한 세부사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "관인의 비치 및 보관자",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(관인의 비치 및 보관자) ①조달청장의 관인은 본청 운영지원팀에, 품질관리단장 및 각 지방청장의 관인은 문서취급부서에 비치하고 각각 비치부서장이 보관한다.② 회계관계공무원의 관인은 해당 회계담당공무원이 보관하며 기타 관인은 해당 부서장이 보관한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "관인의 교부 및 재교부",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(관인의 교부 및 재교부) 관인교부 또는 분실, 마멸 등으로 재교부를 받고자 할 때에는 그 직근 상급관서에 교부를 신청하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "폐기",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(폐기) 기관의 폐지 및 관인의 마멸 등으로 관인을 폐기하고자 할 때에는 교부기관에 폐기를 요청하여 승인을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "관인대장",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(관인대장) ①관인 교부기관은 관인대장을 비치하여 신조, 개각 또는 폐기 할 때에는 그 관인을 날인하고 필요한 사항을 기록·정리하여야 한다.② 관인대장은 별책으로 영구 보존하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "공고",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(공고) 관인을 교부, 재교부 또는 폐기하였을 때에는 이를 관보에 공고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "관인의 사고보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(관인의 사고보고) 관인 보관자는 관인의 도난, 분실 또는 변조 등의 사고가 발생하였을 때에는 즉시 교부기관에 사고 내용을 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "기타",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(기타) 회계관계공무원 직인에 관한 사항은 회계관계공무원 직인규칙에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청관인규칙#JO0008"
      }
    ]
  },
