    "article_count": 12,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 지방행정연수원(이하 \"연수원”이라 한다)에서 시행하는 포상의 기준과 절차를 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "포상대상",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(포상대상) 이 규정에 의한 포상은 연수원 발전과 교육행정에 현저한 공이 있어 타의 모범이 된 자에게 수여한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "포상권자",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(포상권자) 포상은 원장이 수여한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "포상의 종류",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(포상의 종류) 이 규정에 의한 포상은 표창장, 상장 및 감사장으로 구분하여 시행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "표창장",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(표창장) 표창장은 다음 각 호의 경우에 수여한다.1. 연수원의 발전과 교육행정에 기여한 공적이 현저한 경우2. 연수원 소속공무원으로 성실히 직무를 수행하여 근무실적이 탁월한 경우",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "감사장",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(감사장) 감사장은 연수원 발전에 적극 협조하거나 대외적으로 연수원의 명예를 높이 선양시킨 개인이나 단체에 수여한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "상장",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(상장) 상장은 다음 각 호의 경우에 수여한다.1. 학술·예술·체육 그 밖의 경진대회에서 우수한 성적을 나타낸 경우2. 기타 상장을 수여할 필요가 있을 경우",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "포상절차",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(포상절차) ① 제5조 내지 제7조에서 규정한 포상자를 선발할 경우에는 정부포상규정 제13조에 의한 공적심사위원회의 심의를 거쳐 선발한다.② 공무원에 대한 정기적인 표창장 수여자 선발은 각 과장의 추천에 의하여 공적심사위원회의 심의를 거쳐 대상자를 확정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "부상",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(부상) 제5조 내지 제7조에 의한 포상은 상금, 상장 기타 부상과 함께 수여할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "포상시기",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(포상시기) 포상은 정기적으로 시행함을 원칙으로 한다. 다만, 필요한 경우에는 수시로 행할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "이중포상 금지",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(이중포상 금지) 같은 공적에 대하여 이중으로 포상할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "포상대장 등재",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(포상대장 등재) 이 규정에 의한 포상은 포상대장에 등재하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방행정연수원포상규정#JO0012"
      }
    ]
