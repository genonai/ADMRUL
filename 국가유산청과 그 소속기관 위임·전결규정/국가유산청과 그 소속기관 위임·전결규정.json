      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 문화재청의 위임 및 전결에 관한 사항은 다른 법령에 별도로 규정되어 있는 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:문화재청과그소속기관위임전결규정#JO0002"
