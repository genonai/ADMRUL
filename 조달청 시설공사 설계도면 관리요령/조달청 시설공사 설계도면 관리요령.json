    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제1조(목적) 이 요령은 조달청에서 보관 관리하고 있는 시설공사 설계도면(CD-ROM 등을 포함한다. 이하 \"도면”이라 한다)의 효율적인 보안관리를 함에 있어 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청시설공사설계도면관리요령#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "도면의 분류",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제2조(도면의 분류) 도면은 시설보안의 중요도에 따라 비밀도면과 일반도면으로 분류 보관한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청시설공사설계도면관리요령#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "도면관리",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제3조(도면관리) 도면을 보관하고 있는 각 팀의 팀장은 당해공사 담당공무원으로 하여금 보관·관리하도록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청시설공사설계도면관리요령#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "대출",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제4조(대출) 도면은 업무처리상 불가피하고 담당공무원이 일정한 장소에 직접 휴대하는 경우 이외에는 대출할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청시설공사설계도면관리요령#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "열람",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제5조(열람) 도면의 열람은 당해공사와 업무상 직접 관련이 있는 자에 한하여 열람할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청시설공사설계도면관리요령#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "복제, 복사",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제6조(복제, 복사) 도면의 복제, 복사는 원칙적으로 불허한다. 다만, 업무처리상 부분복사가 불가피한 사유가 발생한 경우에는 소속팀장의 승인을 얻어 허락할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청시설공사설계도면관리요령#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "도면의 보존",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제7조(도면의 보존) ①공사계약체결이후 설계도면 보존은 수요기관에 계약체결 통보시 1개월 이내에 인수록 요청하고 수요기관에서 도면인수 의사가 없어 반납이 곤란한 경우에는 당해공사계약 체결이후 폐기처분한다.②대외비 및 비밀로 분류된 설계도면은 당해문서의 예고문에 의하여 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:조달청시설공사설계도면관리요령#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "재검토기한",
        "chapter": "제1장  총  칙",
        "chapter_path": "제1장  총  칙",
        "content": "제8조(재검토기한) 이 훈령은 2016년 1월 1일을 기준으로 매 3년이 되는 시점(매 3년째의 12월31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
