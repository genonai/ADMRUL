        "chapter": "",
        "chapter_path": "",
        "content": "제13조 (평가실시권자) 직장훈련의 평가는 직장훈련 실시기관의 장이 평가 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양경찰공무원직장훈련시행규칙#JO0013"
