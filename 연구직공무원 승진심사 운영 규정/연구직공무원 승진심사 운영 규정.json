  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 공무원임용령 제34조의3의 규정에 의하여 국립산림과학원 소속 연구직공무원의 승진심사를 객관적이고 공정하게 실시하기 위하여 보통승진심사위원회 운영에 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 이 규정은 국립산림과학원 소속 연구사를 연구관으로 임용하기 위한 승진심사에 한하여 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "승진심사대상자",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(승진심사대상자) 승진심사대상자는 승진심사 공고일 전일 기준으로 승진후보자명부의 순위가 공무원임용령 별표5에 해당하는 자로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "심사자료제출",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(심사자료제출) 승진심사대상자는 별지 제1호 서식의 업무추진실적 기술서를 작성하여 연구지원과로 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "역량평가 실시",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(역량평가 실시) ①승진심사대상자에 대하여 역량평가를 실시하되. 역량평가는 기획력 평가와 인터뷰 평가로 구분하여 실시한다.②기획력 평가와 인터뷰평가는 평가의 공정성과 객관성 제고를 위하여 외부위원이 평가한다.③역량평가에 대한 구체적인 실시 방법과 절차 등은 별도로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "다면평가 실시",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(다면평가 실시) 승진심사 참고자료로 활용하기 위하여 승진심사대상자에 대한 다면평가를 실시 할 수 있으며, 다면평가단 구성 및 운영에 대한 구체적 사항은 별도로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "승진심사검토서 작성 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(승진심사검토서 작성 등) ①연구지원과에서는 승진심사대상자의 승진후보자명부 점수(70%)와 역량평가 점수(기획력평가 20%, 인터뷰 평가 10%)를 합산하여 별지 제2호 서식의 승진심사검토서를 작성한 후 개인별 업무추진실적 기술서를 첨부하여 승진심사위원회에 상정한다.② 다면평가를 실시한 경우에는 제1항의 자료 외에 별지 제3호 서식의 다면평가위원회 평가결과를 별도로 작성하여 승진심사위원회에 상정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "승진심사위원회의 결정",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(승진심사위원회의 결정) ①승진심사위원회에서는 승진심사검토서 및 개인별 업무추진실적 기술서, 다면평가 결과 등을 종합적으로 검토하여 승진대상자를 최종 결정한다.②승진심사위원장은 승진심사결과를 원장에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "기타사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(기타사항) 승진심사위원회 위원으로 선정된 자는 별지 제4호서식의 서약서를 작성·제출하여야 하며, 심사자료 등은 공개하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:연구직공무원승진심사운영규정#JO0009"
      }
    ]
