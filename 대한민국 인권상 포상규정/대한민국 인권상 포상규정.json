        "chapter": "",
        "chapter_path": "",
        "content": "제10조(심사기준) 포상대상자 심사기준은 별표와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국인권상포상규정#JO0010"
