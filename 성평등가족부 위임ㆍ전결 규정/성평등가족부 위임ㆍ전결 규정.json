  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 행정권한의 위임 및 위탁에 관한 규정 제3조에 의하여 여성가족부 소관업무의 전결사항과 절차를 정함으로써 행정능률을 제고하고 업무의 권한과 책임을 명확하게 함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 여성가족부의 위임·전결사항은 다른 법령에 특별한 규정이 있는 것을 제외하고는 이 규정이 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "결재권의 위임",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(결재권의 위임) 장관 명의로 시행하는 문서는 장관의 결재를 받는 것을 원칙으로 하되 처리사항의 경중에 따라 이를 차관, 실장, 국장, 관, 과장 및 담당관, 과원(복수직 서기관 및 사무관 등)에게 전결권을 위임한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항 및 전결권자",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(전결사항 및 전결권자) ① 위임·전결사항 및 전결권자는 \"별표\"와 같다.② 별표에 열거되지 아니한 사항은 당해 업무의 성격과 중요도에 따라 이 영에 규정된 위임·전결 사항에 준하여 전결 처리한다. 다만, 전결권을 정하기 어려운 경우에는 차상급자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(보고) 전결권자가 전결시행한 사항중 상급 결재권자가 알아야 한다고 인정되는 사항은 사후에 그 처리내용을 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "협의사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(협의사항) 위임·전결 사항중 다른 실·국의 과와 업무상 관련 있는 사항(법령의 해석 업무 포함)에 대하여는 해당 기관의 협의 또는 협조를 얻어야 하며, 합의에 이르지 못하거나 협조를 얻지 못한 사항에 대해서는 그 사유를 명시하여 그 공통된 상급자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "부재시 결재",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(부재시 결재) 결재권자가 휴가·출장 기타의 사유로 상당기간 부재중이거나 긴급한 사항임에도 결재권자의 사정에 의하여 결재를 받을 수 없는 때에는 그 직무를 대리하는 자가 대결할 수 있으며, 내용이 중요하다고 인정되는 사항에 대하여는 결재권자에게 사후보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "전결권자의 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(전결권자의 책임) 위임·전결사항에 대하여는 전결권자가 장관에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:여성가족부위임전결규정#JO0008"
      }
    ]
