00 │┃\n┃│          ├─────────────┼────┼────┼──────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┤┃\n┃│          │2급지 \"나\"(면지역)        │        │285,600 │259,800     │257,400 │        │290,400 │464,600 │249,000 │        │318,000 │238,800 │303,000 │256,200 │        │271,200 │247,200 │306,000 │┃\n┃│          ├─────────────┼────┼────┼──────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┤┃\n┃│          │3급지(도서벽지)           │        │        │            │216,000 │        │247,800 │350,000 │        │        │        │195,600 │242,400 │216,000 │        │217,200 │210,000 │216,000 │┃\n┃├─────┼─────────────┼────┼────┼──────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┼────┤┃\n┃│방송통신고│                          │67,500  │55,200  │시)57,600   │42,600  │67,800  │58,800  │70,400  │48,600  │69,900  │65,400  │41,400  │42,000  │30,000  │        │40,500  │41,400  │40,200  │┃\n┃│          │                          │        │        │가터)42,000 │        │        │        │        │        │        │        │        │        │        │        │        │        │        │┃\n┃└─────┴─────────────┴────┴────┴──────┴────┴────┴────┴────┴────┴────┴────┴────┴────┴────┴────┴────┴────┴────┘┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n\n제3조 중 “2019년 1월 1일 기준으로 매3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다”를 “2019년 7월 1일을 기준으로 3년마다(매 3년째의 6월 30일까지를 말한다)”로 한다.\n부칙\n이 고시는 발령한 날부터 시행한다.",
  "revision_reason": "◇ 개정이유\n자연재난 발생 시 이재민 구호를 위한 지원 중 생계지원 및 고등학교 학자금(수업료) 관련 규정* 개정에 따라 자연재난 복구비용 단가 조정\n* 「긴급지원 지원금액 및 재산의 합계액기준(보건복지부고시)」, 「학교 수업료 및 입학금에 관한 조례 시행규칙」(교육청조례)\n◇ 주요내용\n가. 이재민 구호를 위한 지원 단가 조정\n- 「긴급지원 지원금액 및 재산의 합계액 기준(보건복지부고시)」 개정 (2018.12.21.)에 따른 생계지원 단가 개정\n- 「학교 수업료 및 입학금에 관한 조례 시행규칙」에 따른 ‘19년 학자금(수업료) 단가 개정사항 반영\n나. 문구 띄어쓰기 등 자구 수정 및 재검토 기한 변경*\n* (기존) 2019년 1월 1일 -> (변경) 2019년 7월 1일",
