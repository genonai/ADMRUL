    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 방사선규칙 제55조제2항·제6항 및 제8항의 규정에 따라 방사성동위원소의 판매취급 및 이와 관련하여 발생한 방사성폐기물의 수거·폐기에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:방사성동위원소판매자의준수규정#JO0001"
