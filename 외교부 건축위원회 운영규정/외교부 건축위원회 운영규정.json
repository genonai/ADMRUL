  "body": {
    "format": "articles",
    "article_count": 11,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "설치",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(설치) 재외공관용 부동산의 취득·관리 등에 특별법의 규정에 따라 재외공관용 부동산의 취득·관리에 관한 사항에 관한 자문을 위하여 외교통상부에 재외공관용 부동산취득·관리자문위원회(이하 \"위원회\"라 한다)를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(정의) 이 규정에서 재외공관용 부동산이라 함은 재외공관에서 사용하는 청사·관저, 직원주택 기타 재외공관에 속한 국유의 건물 및 토지를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "기능",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(기능) 위원회는 다음 사항에 대한 자문에 응한다.1. 재외공관 국유화사업의 중장기계획에 관한 사항2. 재외공관용 부동산의 매입 및 건물의 신축 등에 관한 사항3. 재외공관용 부동산의 관리 및 매각에 관한 사항4. 재외공관 국유화사업의 사업분석 및 평가에 관한 사항5. 기타 위원장이 필요하다고 판단하는 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(구성) ①위원회는 위원장 1인과 15인 이내의 위원으로 구성한다.②위원장은 기획관리실장이 되고, 위원은 장관이 지명 또는 위촉한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "직무",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (직무) ①위원장은 위원회를 대표하며 위원회의 회무를 통할한다.②위원회의 서무를 처리하기 위하여 간사 1인을 두되, 간사는 기획관리실 재외공관재산담당관이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "회의소집",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(회의소집) ①위원회의 회의는 위원장이 소집한다.②위원회는 반기별 1회 소집을 원칙으로 하되, 필요시 수시소집될 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "자문위원위촉",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(자문위원위촉) ①자문위원은 5인의 일반자문위원과 10인의 기술자문위원으로 구분한다.②일반자문위원은 전·현직 공관장 경력자중에서, 기술자문위원은 건설 기술 또는 해외부동산에 관한 전문 지식과 경험을 가진 자중에서 위원장의 제청으로 장관이 지명 또는 위촉한다.③기술자문위원의 위촉기간은 3년으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "기술자문위원",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(기술자문위원) ①기술자문위원의 위촉대상 분야는 다음 각호와 같다.1. 건축: 구조·시공·건축설계2. 토목: 토질·기초·구조·상하수도·시공·조경3. 기계: 냉·난방 및 냉동기계(또는 건축기계설비), 소방시설4. 전기: 전기설비(또는 건축전기설비)5. 통신: 전기통신 및 보안시설6. 기타: 해외부동산②기술자문위원은 해당 분야의 대학교수, 기술자격 또는 면허 소지자, 박사학위소지자 및 관계공무원 중에서 위촉한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "현지확인제도",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(현지확인제도) 위원장은 국유화사업 수행을 위해 필요하다고 판단할 경우 현장조사를 위해 자문위원을 현지에 파견할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "수당 등의 지급",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(수당 등의 지급) ①자문위원에 대하여는 예산의 범위내에서 수당 등 필요한 경비를 지급할 수 있다.②위원회의 직무수행상 국내외 출장이 필요한 경우 필요한 여비를 예산의 범위내에서 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "운영세칙",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(운영세칙) 이 규정외에 위원회의 운영에 관하여 필요한 사항은 위원장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재외공관용부동산취득관리자문위원회규정#JO0011"
      }
    ]
