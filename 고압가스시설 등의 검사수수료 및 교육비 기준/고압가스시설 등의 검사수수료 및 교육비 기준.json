  │\n│              ├──────┼───────────┼───────────┤\n│              │5톤초과     │7만6천원              │4만8천원              │\n│              │10톤이하    │                      │                      │\n│              ├──────┼───────────┼───────────┤\n│              │10톤초과    │14만2천원             │8만7천원              │\n│              │30톤이하    │                      │                      │\n│              ├──────┼───────────┼───────────┤\n│              │30톤초과    │18만6천원             │12만5천원             │\n│              │50톤이하    │                      │                      │\n│              ├──────┼───────────┼───────────┤\n│              │50톤초과    │31만8천원             │20만7천원             │\n│              │100톤이하   │                      │                      │\n│              ├──────┼───────────┼───────────┤\n│              │100톤초과   │49만1천원             │30만원                │\n│              │200톤이하   │                      │                      │\n│              ├──────┼───────────┼───────────┤\n│              │200톤초과   │59만3천원             │38만4천원             │\n│              │300톤이하   │                      │                      │\n│              ├──────┼───────────┼───────────┤\n│              │300톤초과   │79만2천원             │55만1천원             │\n│              │500톤이하   │                      │                      │\n│              ├──────┼───────────┼───────────┤\n│              │500톤초과   │ 79만2천원에 500톤을  │ 55만1천원에 500톤을  │\n│              │            │초과한 100톤마다      │초과한 100톤마다      │\n│              │            │12만6천원을 가산한    │11만2천원을 가산한    │\n│              │            │금액.                 │금액.                 │\n│              │            │ 다만, 153만원을      │ 다만, 119만원을초    │\n│              │            │초과할 수 없다.       │과 할 수 없다.        │\n└───────┴──────┴───────────┴───────────┘\n┌───────────────┬─────────────────────────┐\n│대            상              │금         액                                     │\n├────┬──────────┼────────────┬────────────┤\n