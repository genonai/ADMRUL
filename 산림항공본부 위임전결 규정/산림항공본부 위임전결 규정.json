    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 산림항공본부 제반업무에 관한 전결 사항과 그 절차를 정하여 효율적인 업무 수행을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림항공본부위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 이 규정은 따로 법령에 규정되어 있는 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림항공본부위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(전결사항)① 항공지원과, 산림항공과, 항공정비과 및 항공안전과의 과장급 위임전결사항은 별표와 같다.② 별표에 열거되지 아니한 사항으로서 위임전결사항보다 경미한 사항은 그 전결권자가 전결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림항공본부위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항의 특례",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(전결사항의 특례)①전결권자는 그의 전결사항이라 하더라도 특히 중요하다고 인정하는 사항이거나 이례적인 사항에 대하여는 이 규정에 불구하고 본부장의 결재를 받아야 한다.②본부장이 특별히 지시한 사항은 이 규정에 불구하고 본부장의 결재를 받아야 한다.③전결사항 중 타 과와 관련된 사항으로써 협의사항 중 협의안에 대하여 다른 의견이 있을 때에는 본부장의 결재를 받아야 한다.④전결사항이라 할지라도 전결권자 부재시에는 본부장의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림항공본부위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결권자의 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(전결권자의 책임) ①전결권자의 전결사항은 차하위자에게 전가할 수 없다.②전결 처리한 사항에 대하여는 그 전결권자가 본부장에 대하여 책임을 진다.③협조자가 협조의견을 표시하지 않은 경우에는 동의한 것으로 간주하고 이에 대한 응분의 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림항공본부위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(보고) 전결권자가 전결 시행한 사항중 상급자가 알아야 한다고 인정되는 사항은 사전 또는 사후에 그 처리내용을 구두로 보고한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:산림항공본부위임전결규정#JO0006"
      }
    ]
