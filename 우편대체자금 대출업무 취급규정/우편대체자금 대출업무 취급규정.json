    "articles": [
      {
        "article_no": "제2조",
        "article_title": "대출운용원칙",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(대출운용원칙)대출금은 기간통신사업자의 1년 이내 단기운영자금에 한하여 대출하며, 별지 제3호서식의 대출금관리부에 의하여 관리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "담보",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(담보)대출금에 대한 담보는 미래창조과학부장관이 인정하는 기관의 지급보증을 원칙으로 하되 필요한 경우 물적담보를 설정할 수 있다. 다만, 정부에게 투자 또는 출자한 기간통신사업자 및 미래창조과학부장관이 이에 준한 것으로 인정하는 기간통신사업자의 경우에는 지급보증 또는 물적담보를 생략할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "대출기간 및 방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(대출기간 및 방법)대출기간은 1년으로 하고 대출방법은 증서 대출로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "상환방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(상환방법)대출금의 원금은 약정기일에 일시불로 상환하거나 분할하여 상환하며, 그 이자는 연 4회 이상 징수하되, 대출당시에는 이를 징수하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "이자율",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(이자율)대출금의 이자율은 우편대체법시행규칙 제43조 제1항의 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "이자계산방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(이자계산방법)① 대출금의 이자는 대출금의 원금 또는 잔액에 제6조의 규정에 의한 이자율과 대출기간을 곱한 후 365일(평년 또는 윤년을 구분하지 아니한다)로 나누어 이를 산출한다.(단, 대출기간의 말일이 공휴일인 경우, 그 다음날 변제 시에는 공휴일을 변제일로 한다.)②대출이자는 원단위까지 산출한 후 10원 미만은 절사한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "연체이자",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(연체이자)지정한 기일 내에 대출금의 원금 또는 제7조 제1항의 규정에 의한 이자를 납입하지 아니한 때에는 우편대체법시행규칙 제43조 제2항의 규정에 의한 연체이자를 징수한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "대출약정",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(대출약정)대출은 기간통신사업자와 대출약정을 체결하여 시행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "대출서류",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(대출서류)대출에 필요한 서류는 다음 각호와 같다.1. 대출신청서(별지 제1호 서식)2. 여신거래약정서(별지 제2호 서식)3. 법인등기부등본4. 법인인감증명서5. 기타 필요한 서류",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "대출금의 지급",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(대출금의 지급)대출금의 지급은 수표로서 지급하며, 지급시 별지 제4호서식의 대출금영수증을 기간통신사업자로부터 제출받는다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "대출기간연장",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(대출기간연장)대출기간을 연장하고자 할 경우에는 거래 추가약정을 체결한다. 이 경우 대출기간 연장은 1년 단위로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "대출금의 기한 전 상환",
        "chapter": "",
        "chapter_path": "",
        "content": "제13조(대출금의 기한 전 상환)기간통신사업자가 대출금의 전부 또는 일부를 대출기한 전에 상환하고자 할 경우 그 이자는 대출금의 원금 또는 잔액에 대한 상환 당일까지의 이자로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "대출원리금의 회수",
        "chapter": "",
        "chapter_path": "",
        "content": "제14조(대출원리금의 회수)①대출금의 원금 및 이자를 회수하고자 할 때에는 납입기일 30일전에 별지 제5호서식의 대출원리금 상환통지서에 의하여 기간통신사업자에 이를 통지한다.②회수된 대출금의 원금 및 이자는 다음 각호의 순서에 의하여 충당한다.1. 연체이자2. 약정이자3. 원금",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금대출업무취급세칙#JO0014"
