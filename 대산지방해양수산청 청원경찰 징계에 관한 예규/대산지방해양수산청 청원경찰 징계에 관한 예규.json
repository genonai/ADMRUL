    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 본 규정은 청원경찰법시행령 제17조의 규정에 의거 대산지방해양항만청 소속 청원경찰의 징계사건을 심의, 의결하기 위한 절차를 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대산지방해양항만청청원경찰징계규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 본 규정은 대산지방해양항만청 소속 청원경찰에 대하여 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대산지방해양항만청청원경찰징계규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "징계위원회 구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(징계위원회 구성) ①청원경찰 징계위원회(이하 \"위원회\"라 한다)는 위원장 1인과 4인 이상 6인 이내의 위원으로 구성한다.②위원장은 총무과장이 되고, 선원해사안전과장, 항만물류과장, 항만공사과장, 해양교통시설과장은 당연직 위원이 되며, 그 외 위원은 청장이 임명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대산지방해양항만청청원경찰징계규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "간사",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(간사) ①위원회는 간사 1인을 두며 서무담당으로 한다.②간사는 위원장의 명을 받아 징계에 관한 기록 기타 서류의 작성과 보관에 관한 사무에 종사한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대산지방해양항만청청원경찰징계규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "징계의 종류",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(징계의 종류) 이 규정에 의한 징계의 종류는 파면, 감봉, 견책으로 하며 감봉은 1월 이상 6월이하로 하되 봉급의 3분의1을 감한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대산지방해양항만청청원경찰징계규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "징계의 방법 및 대상",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(징계의 방법 및 대상) 청장은 소속 청원경찰이 다음 각 호의 1에 해당한 때 또는 관할 경찰서장으로부터 징계요청을 받은 때에는 대산지방해양항만청 보통징계위원회 위원장에게 징계의결을 요구하여야 한다.1. 청원경찰법 및 동법시행령 또는 이에 정한 명령에 위반한 때2. 직무상의 업무에 위반하거나 직무를 태만히 한 때3. 품위를 손상하게 한 때",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대산지방해양항만청청원경찰징계규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "준용",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(준용) 징계의결 요구 및 징계의결에 관한 사항은 대산지방해양항만청 보통징계위원회 운영규정(대산지방해양항만청 예규 제13호)을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대산지방해양항만청청원경찰징계규정#JO0007"
      }
    ]
