    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 고시는 농수산물품질관리법(이하 \"법\"이라 한다) 제98조 및 동법시행규칙(이하 \"규칙\"이라 한다) 제128조의 규정에 의하여 수산물·수산가공품의 검정에 관하여 필요한 세부요령을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:수산물등의검정에관한세부요령#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (정의) 수산물 \"검정\"이라 함은 검사품목에 대한 검사항목의 분석 감정을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:수산물등의검정에관한세부요령#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "검정의 실시",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (검정의 실시) ① 법 제98조제1항 및 규칙 제126조제1항의 규정에 의거 수산물 등의 검정신청을 받은 국립수산물품질관리원장(이하 \"원장\"이라 하며 지원장을 포함한다)은 다음 각호의 1에 해당하는 경우 외에는 검정을 실시하여야 한다.1. 검정에 필요한 시설·장비를 갖추지 않았거나 검사원이 검정 전문기술을 갖추지 않았을 때2. 기타 검정신청에 응할 수 없는 상당한 이유가 있을 때② 원장은 제1항 각호의 1의 사유로 검정을 할 수 없는 경우에는 신청자에게 그 뜻을 통지하고, 제출된 검정시료가 있는 때에는 이를 반환하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:수산물등의검정에관한세부요령#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "검정증명서 사본의 발급",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (검정증명서 사본의 발급) 규칙 제126조의 규정에 의하여 검정증명서 발급을 받은 자가 그 사본을 발급 받고자 하는 경우에는 원장에게 요청하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:수산물등의검정에관한세부요령#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "검정항목에 대한 시험방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (검정항목에 대한 시험방법) 규칙 제127조의 규정에 의한 검정항목에 대한 시험방법은 「식품위생법」 제14조의 규정에 의하여 식품의약품안전처장이 정한 시험방법을 준용한다. 다만, 시험방법이 수재되어 있지 아니한 경우에는 국제식품규격(CODEX) 및 공인분석법(AOAC) 등의 시험방법에 따라 시험할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:수산물등의검정에관한세부요령#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수수료",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (수수료) 규칙 제139조의 규정에 의거 신청자는 수수료를 정부수입인지로 납부하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:수산물등의검정에관한세부요령#JO0006"
      }
    ]
