  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 사무관리규정 제6조의 규정에 의하여 민주평화통일자문회의사무처소속 공무원의 사무의 인계인수에 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용) 사무의 인계인수에 관한 사항은 다른 법령에 따로 규정된 것을 제외하고는 이 규정에 정하는 바에 의하며, 사무의 인계인수를 하여야 할 공무원은 민주평화통일자문회의사무처직제상의 기본단위조직의 장(과장 또는 담당관)이상으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "인계인수의 사유",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(인계인수의 사유) ①공무원임용령 제2조제1호의 규정에 의한 임용 또는 30일이상의 장기출장과 휴가 등의 명령을 받은 때에는 담당사무를 인계인수하여야 한다.② 사무인계인수자의 사고 또는 후임자의 미보충 등으로 사무의 인계인수자가 없는 때에는 소속부서장이 지정한 자가 인계인수를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "인계인수의 기준일",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(인계인수의 기준일) 사무의 인계인수의 작성기준일은 제3조의 규정에 의한 명령을 받은 날의 전일 현재로 하고, 그 날로부터 2일이내에 인계인수를 완료하는 것을 원칙으로 한다. 다만, 그 기간내에 사무의 인계인수를 완료하지 못한 때에는 직근상급자의 승인을 얻어 그 기간을 연장할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "인계인수의 사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(인계인수의 사항) ①사무의 인계인수사항은 별표1의 항목중 인계자가 담당하는 사무의 주요사항으로 한다.②제1항의 지정항목 이외에 특별히 인계인수가 필요한 사항은 추가로 포함하여 인계인수할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "인계인수서의 작성",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(인계인수서의 작성) 사무의 인계인수서는 4부를 작성하여 그중 인계자와 인수자가 각1부씩 소지하고, 1부는 그 부서에 보관하며, 1부는 운영지원담당관에게 즉시 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "입회자의 지정",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(입회자의 지정) 사무의 인계인수시 입회자는 직근상급자가 되는 것을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(보고) 사무를 인계인수한 자는 사무인계인수의 결과를 직근상급자에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:민주평화통일자문회의사무처사무인계인수규정#JO0008"
      }
    ]
