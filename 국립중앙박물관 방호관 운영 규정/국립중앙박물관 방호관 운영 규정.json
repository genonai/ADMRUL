  "body": {
    "format": "articles",
    "article_count": 13,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 방호근무에 관한 사항을 정함을 목적으로  한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "근무",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(근무) 방호원은 다음 각 호의 업무를 담당한다.1. 청사와 전시실, 유물수장고 및 소장유물의 주. 야간 경비2. 출입자의 통제3. 물품 및 유물 반출·반입의 확인4. 야간근무 및 순찰",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "조직",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(조직) ①방호원의 지도·감독을 위해 방호실장 1인과 부방호실장 1인을 둘 수 있다.②방호근무의 원활을 기하기 위하여 전시실 근무, 외곽근무 및 야간근무의 감독을 위한 별도의 책임자를 둘 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임명",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(임명) 방호실장과 부방호실장은 기능직 방호원 중에서 행정지원과장의 내신으로 관장이 임명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "방호장",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(방호장) ①방호실장은 행정지원과장의 지시에 따라 방호근무사항을 감독하고 화재와 도난예방을 위한 청사의 경비순찰을 담당한다.②부방호실장은 방호실장을 보좌하고 방호실장 사고시 그 직무를 대행 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "근무요령",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(근무요령) 방호원은 근무명령에 따라 외곽초소, 전시실, 유물수장고, 현관 및 순찰근무를 원칙으로 하되 근무지 이탈 및 근무 중 음주는 엄금한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "배치",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(배치) 방호원의 근무배치는 방호실장이 정하되 행정지원과장의 사전승인을 얻어 배치토록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "의무",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(의무) 방호원은 소방규칙, 당직 및 비상근무 규정, 출입증관리지침, 전시실관리지침을 숙지하여 근무에 철저를 기한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "규정 등 비치",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(규정 등 비치) 현관 안내실에는 근무명령서 및 제 규정철을 비치하고 활용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "근무시간 등 변경",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(근무시간 등 변경) 방호근무시간 및 근무지를 변경하고자 할 때는 사전에 행정지원과장의 승인을 얻어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "인계인수",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(인계인수) 방호근무 인계인수 사항은 다음 각 호의 사항과 같다.1. 지시 받은 사항2. 근무 중 발생한 특이사항3. 기타 각종 일지 및 기록사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "복장",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(복장) 방호원은 근무시간 중 지정복을 착용하고 단정한 복장으로 관람객 및 내빈에게 친절을 다하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "순찰",
        "chapter": "",
        "chapter_path": "",
        "content": "제13조(순찰) 방호원은 2시간 간격으로 순찰을 하고 이상 유무를 확인한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관방호근무규칙#JO0013"
      }
    ]
  },
