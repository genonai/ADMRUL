    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 규정은 외무공무원임용령(이하 \"영\"이라 한다.) 제20조의규정에 의하여 특수지역의 지정·해제, 적용기간 및 적용대상 등 특수지역제도의운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특수지역지정등에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "제도운영방향",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (제도운영방향)특수지역 제도는 법령의 예외사항에 해당되는 것이므로 이를 제한적으로 운용하여야한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특수지역지정등에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "지정대상 범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (지정대상 범위)영 제20조의 특수지역은 다음 각호의 1에해당하는 지역 가운데서 지정한다.1. 신변안전 보험의 적용을 받는 지역2. 재외공무원수당지급규칙에 규정된 특수지 근무수당지급대상 지역3. 영사관이 설치된 지역(총영사관으로 승격된 지역을 포함한다.)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특수지역지정등에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "특수지역 지정",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (특수지역 지정)특수지역은 매년 4월에 외무인사위원회(이하 \"위원회\"라 한다)의 심의를 거쳐 장관이지정한다. 장관은 특히 필요하다고 인정하는 경우 지정시기를 조정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특수지역지정등에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "특수지역 해제",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (특수지역 해제)위원회는 매년 4월에 기지정된 특수지역에 대해 지정 사유의 존속 또는 소멸여부 등을 심의하여야 하며, 특수지역의 지정사유가 소멸되었다고 인정되는 경우장관에게 특수지역의 지정해제를 건의하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특수지역지정등에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "적용기간",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (적용기간)특수지역의 지정 또는 해제는 장관이 위원회의 지정 또는 해제 건의를 승인하는날로부터 효력을 발생하며, 이를 소급하여 적용할 수 없다.다만, 제3조제3호의 경우는 예외로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특수지역지정등에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "적용대상 지역",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조 (적용대상 지역)제4조의 규정에 의거하여 지정한 특수지역은별표와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:특수지역지정등에관한규정#JO0007"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "19860526",
      "promulgation_no": "172",
      "content": "부칙 <제172호,1986. 5. 26.>제1조 (시행일) 이 규정은 공포한 날로부터 시행한다.제2조 (기지정 지역의 해제에 따른 경과조치) ①영 부칙 제3조에 의거하여 특수지역으로 지정되어 있는 지역으로서 이 규정에의하여 특수지역으로 재지정을 받지 못하는 지역은 특수지역의 적용에서 제외된다.②제1항에 의하여 특수지역의 적용이 제외되는 지역 소재 재외공관의 장으로 이규정 시행당시 재직한 공관장에 대해서는 해당 지역 재직기간에 한해 공관장근속정년기간에 이를 산입하지 아니한다.",
      "provision_id": "admrul:특수지역지정등에관한규정#ADDENDUM"
    }
  ],
