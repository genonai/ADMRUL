    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 사무관리규정 제16조제2항의 규정에 의하여 법무부 문서결재에 관한 전결사항과 그 절차를 정하여 효율적인 업무수행을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용) 위임전결에 관한 사항은 다른 법령에 규정되어 있는 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(전결사항) ①차관이하 각 부서장 등의 위임전결사항은 별표와 같다②별표의 공통 위임전결사항 중 감찰관·총무과장은 실·국·본부장에 준하며, 홍보관리관·성과기획조정관·출입국관리정책관·통합지원정책관 및 정책기획관은 실·국·본부장의 전결 사무 중 사안에 따라 필요한 경우 전결할 수 있다.③별표에 열거되지 아니한 업무에 대하여는 당해업무와 유사한 업무의 전결권자가 전결할 수 있다. 다만, 이 경우 전결여부의 판단이 어려운 때에는 상급결재권자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결의 효력",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(전결의 효력) \"전결\"의 표시가 된 문서에 대하여는 장관이 서명 또는 날인한 것과 같은 효력을 갖는다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결의 책임",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(전결의 책임) 전결 처리한 문서에 대하여는 그 전결권자가 장관에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "결재방법",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(결재방법) ①장·차관 결재사항은 비대면 결재를 원칙으로 한다. 비대면 결재문서는 비서관이 일괄 접수·결재받는 것으로 하되, 긴급을 요하는 경우에는 황색의 결재서류판을 사용한다.②제1항의 규정에도 불구하고 결재 사안이 중요하거나 성질상 필요하다고 인정되는 경우에는 대면결재를 한다.③제2항의 규정에 의한 대면결재 시 원칙적으로 장관 결재사항은 과장급이상이, 차관 결재사항은 검사 또는 서기관이상이 결재 받는다. 다만, 불가피한 경우 직근 하급자 순으로 결재를 받을 수 있다.④실·국·본부장의 결재사항은 검사 또는 사무관이상이 결재 받는다. 다만, 단순 통보 등 공람성격의 문서는 부속실에서 접수, 결재 받는다.⑤일상적 업무 등 경미한 사항은 구두 또는 메모형식의 보고방법을 적극 활용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "합의사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(합의사항) 위임전결사항 중 다른 부서와 관련되는 사항은 합의하여야 하며, 합의를 보지 못하였을 때에는 관련부서를 모두 감독할 수 있는 상급 결재권자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "중요사항등의 결재",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(중요사항등의 결재) 전결권자는 그의 전결사항이라 할지라도 그 사안이 중요하거나 성질상 필요하다고 인정되는 경우에는 상급 결재권자의 결재를 받을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(보고) 전결권자가 전결 시행한 사항 중 상급 결재권자에게 보고할 필요가 있다고 인정되는 사항은 사후에 그 처리내용을 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:법무부위임전결규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "규정준수",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(규정준수) 문서에 대한 결재에 있어 불필요한 상향결재를 지양한다.",
        "enforcement_date": "",
