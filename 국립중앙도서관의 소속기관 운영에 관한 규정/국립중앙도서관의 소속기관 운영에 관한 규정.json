    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 독립청사 여부 및 행정조직 규모 등에 따라 국립중앙도서관 소속기관의 조직운영 방식 및 지원·관리 등에 관한 사항을 정함으로써 행정의 효율성 및 통일성 확보를 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관의소속기관운영에관한규정#JO0001"
