        "article_no": "제4조",
        "article_title": "복무관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(복무관리) 법무심의관은 전문위원의 업무를 지휘·감독한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:주택임대차위원회직원규정#JO0004"
