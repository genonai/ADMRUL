│  │2.1.          │2.1.1.                │○            │○              │×                │×                              │\n│  │네트워크 보   │트래픽 모니터링       │              │                │                  │                                │\n│  │안            ├───────────┼───────┼────────┼─────────┼────────────────┤\n│2.│              │2.1.2.                │○            │×              │×                │×                              │\n│기│              │무선서비스 보안       │              │                │                  │                                │\n│술│              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│적│              │2.1.3.                │○            │○              │×                │○                              │\n│  │              │정보보호시스템 설     │              │                │                  │                                │\n│보│              │치?운영              │              │                │                  │                                │\n│호├───────┼───────────┼───────┼────────┼─────────┼────────────────┤\n│조│2.2.          │2.2.1.                │○            │×              │×                │○                              │\n│치│정보통신      │웹서버 보안           │              │                │                  │                                │\n│  │설비 보안     ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.2.                │○            │×              │×                │○                              │\n│  │              │DNS서버 보안          │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.3.                │○            │×              │×                │○                              │\n│  │              │DHCP서버 보안         │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.4.                │○            │×              │×                │○                              │\n│  │              │DB서버 보안           │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.5.                │○            │○              │×                │×                              │\n│  │              │라우터/스위치 보      │              │                │                  │                                │\n│  │              │안                    │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.6.                │○            │○              │×                │○                              │\n│  │              │정보보호시스템        │              │                │                  │                                │\n│  │              │보안                  │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.7.                │○            │○              │○                │○                              │\n│  │              │취약점 점검           │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.8.                │○            │○              │○                │○                              │\n│  │              │접근통제 및 보안      │              │                │                  │                                │\n│  │              │설정 관리             │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.9.                │○            │○              │○                │○                              │\n│  │              │관리자 계정의         │              │                │                  │                                │\n│  │              │비밀번호 관리         │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.10.               │○            │○              │×                │×                              │\n│  │              │로그 관리             │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.11.               │○            │○              │○                │○                              │\n│  │              │보안패치 관리         │              │                │                  │                                │\n│  │              ├───────────┼───────┼────────┼─────────┼────────────────┤\n│  │              │2.2.12.               │○            │○              │×                │○                              │\n│  │              │백업 및 복구          │              │                │                  │                                │\n├─┼───────┼───────────┼───────┼────────┼─────────┼────────────────┤\n│3.│3.1.          │3.1.1. 정보통신시     │×            │○              │×                │×                              │\n│물│출입 및 접    │설의 출입?접근 통    │              │                │                  │                                │\n│리│근 보안       │제                    │              │                │                  │                                │\n│적├───────┼───────────┼───────┼────────┼─────────┼────────────────┤\n│  │3.2. 부대설   │3.2.2.                │○            │○              │×                │×                              │\n│보│비 및 시설    │백업설비 설치?운영   │              │                │                  │                                │\n│호│운영?관리    │                      │              │                │                  │                                │\n│조│              │                      │              │                │                  │                                │\n│치│              │                      │              │                │                  │                                │\n└─┴───────┴───────────┴───────┴────────┴─────────┴────────────────┘\n비  고\n1. “기간통신역무 제공자”는 안전진단을 받아야 하는 자중 전기통신사업법 제2조제11호의 기간통신역무를 제공하는 자를 말한다.\n2. 집적정보통신시설 재판매 사업자는 집적정보통신시설사업자가 마련한 시설의 일부를 임대하여 집적정보통신시설사업을 하는 자를 말한다.\n3. “○”는 안전진단을 받아야 하는 사항을 말한다.\n4. “×”는 안전진단을 받지 않는 사항을 말한다.\n5. 1.1.1.의 규정에 따라 정보보호 조직을 구성할 경우 정보보호책임자, 정보보호관리자, 정보보호담당자에게 정보보호 업무가 아닌 업무를 겸직하게 할 수 있으며, 정보보호관리자와 정보보호담당자를 동일한 자로 임명할 수 있다.\n6. 1.3.1.의 규정에 따라 정보보호교육을 실시할 경우 자체 교육 또는 외부전문교육기관에 의한 위탁교육의 방법 중에서 선택하여 실시할 수 있다.\n7. 1.7.1.의 정보통신설비 및 시설의 현황 관리는 「정보보호조치 및 안전진단 방법?절차?수수료에 관한 지침」 별표2 에 따라 작성한 안전진단 대상 설비 및 시설 목록의 작성?관리의 적정성을 말한다.\n8. 2.1.1.의 규정에 따른 주요회선에 대한 트래픽 소통량 모니터링은 관리자 등이 모니터링 현장에 상주하지 않는 방법으로 실시할 수 있다.\n9. 2.2.11.의 규정에 따른 보안패치 정보의 입수?적용 주기는 정보보호관리자의 판단에 따라 정한다.\n10. 2.2.12.의 규정에 따른 주요정보의 백업 주기는 정보보호관리자의 판단에 따라 정한다.\n■ 정보보호조치 및 안전진단 방법?절차?수수료에 관한 지침[별지 제1호서식] <개정 2012.3.15.>\n\n[] 정보보호 안전진단 결과 통지서\n[] 정보보호 조치의 개선권고 내용 및 처리결과 통보서\n\n\n※ [] 에는 해당되는 곳에 √표를 합니다.\n────────┬───┬────────────────────────────────────\n접수번호      │접수일│처리기간\n────────┴───┴────────────────────────────────────\n\n───────┬────────┬────────────────────────────────\n진단 신청인 │회사명 또는 상호│사업자 등록번호\n├────────┼────────────────────────────────\n│대표자 성명     │전화번호\n├────────┴────────────────────────────────\n│주소 또는 소재지\n───────┴─────────────────────────────────────────\n\n───────┬─────────────────────────────────────────\n진단 업체   │회사명 또는 상호\n├─────────────────────────────────────────\n│대표자 성명\n├────────┬────────────────────────────────\n│주소 또는 소재지│전화번호\n───────┴────────┴────────────────────────────────\n\n───────┬─────────────────────────────────────────\n진단 내용   │진단 기간\n│    년       월        일  ~         년        월        일\n├─────────────────────────────────────────\n│정보보호지침 이행\n│  [] 이 행                    [] 미이행\n───────┴─────────────────────────────────────────\n\n───────┬─────────────────────────────────────────\n개선 권고   │권고 내용\n├─────────────────────────────────────────\n│처리 결과\n───────┴─────────────────────────────────────────\n「정보통신망 이용촉진 및 정보보호 등에 관한 법률」제46조3 및 같은 법 시행령 제43조에 따라\n([] 정보보호 안전진단 결과를 제출 [] 정보보호조치의 개선권고내용 및 처리결과를 통보)합니다\n\n\n\n방송통신위원회 귀중\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n\n───────┬───────────────────────────────────┬─────\n제출서류    │ 1. 안전진단수행기관으로부터 통보받은 정보보호 안전진단 결과 사본 1부.│수수료\n│ 2. 정보보호 안전진단 확인증 사본(확인증을 받은 경우에 한함) 1부.     │없  음\n───────┴───────────────────────────────────┴─────\n210mm×297mm[백상지(80g/㎡)]\n\n■ 정보보호조치 및 안전진단 방법?절차?수수료에 관한 지침[별지 제2호서식] <개정 2012.3.15.>\n\n정보보호 안전진단 확인증\n\n───────┬────────┬──────────────────────────────────\n진단 신청인 │회사명 또는 상호│대표자 성명\n├────────┼──────────────────────────────────\n│사업의 종류     │전화번호\n├────────┴──────────────────────────────────\n│주소 또는 소재지\n───────┴───────────────────────────────────────────\n\n───────┬───────────────────────────────────────────\n진단 업체   │대표자 성명\n├───────────────────────────────────────────\n│회사명 또는 상호\n───────┴───────────────────────────────────────────\n\n───────┬───────────────────────────────────────────\n진 단 연 월 │\n│ 년       월        일  ~         년        월        일\n───────┴───────────────────────────────────────────\n\n\n「정보통신망 이용촉진 및 정보보호 등에 관한 법률」제46조3 및 같은 법 시행령 제42조에 따라\n법 제45조제2항에 따라 정보보호조치 및 안전진단 방법?절차?수수료에 관한 지침의 이행 확인을 마쳤\n으므로 정보보호 안전진단 확인증을 교부합니다\n\n\n\n\n년         월         일\n\n\n\n\n안전진단수행기관 제    호      대표 :                                   (서명 또는 인)\n\n\n진단신청인 귀하\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n210mm×297mm[백상지(60g/㎡)]\n\n■ 정보보호조치 및 안전진단 방법?절차?수수료에 관한 지침[별지 제3호서식] <개정 2012.3.15.>\n\n안전진단수행기관 인정신청서\n\n\n※ 색상이 어두운 란은 신청인이 적지 않습니다.\n────────────┬────────────────────────────────┬─────────────────\n접수번호              │접수일                                                          │처리기간   30일\n────────────┴────────────────────────────────┴─────────────────\n\n────────┬────────────────────────────────────┬─────────────────\n신청인        │회사명 또는 상호                                                        │설립일자\n├────────────────────────────────────┼─────────────────\n│대표자 성명                                                             │전화번호\n├────────────────────────────────────┴─────────────────\n│주소(주된 사무소의 소재지)\n├──────────────────────────────────────────────────────\n│자본금\n│ 백만 원(외국인 투자비율        %)\n────────┴──────────────────────────────────────────────────────\n\n────────────┬──────────────────────────────────────────────────\n최근 3년 이내의 연도별 │신청일 기준 1년 이내의 실적\n정보보호 컨설팅 수행실적│총                  백만 원\n├──────────────────────────────────────────────────\n│신청일 기준 1년 초과 2년 이내의 실적\n│총                  백만 원\n├──────────────────────────────────────────────────\n│신청일 기준 1년 초과 2년 이내의 실적\n│총                  백만 원\n├──────────────────────────────────────────────────\n│연평균 실적\n│총                  백만 원\n────────────┴──────────────────────────────────────────────────\n\n────────────┬──────────────────────────────────────────────────\n정보보호기술인력의 수 │명\n────────────┴──────────────────────────────────────────────────\n\n\n\n「정보통신망 이용촉진 및 정보보호 등에 관한 법률」제46조3제1항 및 같은 법 시행령 제46조제1항에\n따라 위와 같이 안전진단수행기관의 인정을 신청합니다.\n\n년         월         일\n\n신청인(대표자)                                   (서명 또는 인)\n\n방송통신위원회 귀중\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n────────┬───────────────────────────────────────────────┬──────\n신청인(대표자)│ 1. 법인의 정관 1부.                                                                          │수수료\n제출서류      │ 2. 별지 제4호서식의 정보보호기술인력 보유현황과 이를 증명할 수 있는 서류 1부.                │없  음\n│ 3. 별지 제5호서식의 정보보호컨설팅 수행실적 명세서와 이를 증명할 수 있는 서류 1부.           │\n────────┼───────────────────────────────────────────────┤\n담당공무원    │    법인등기항증명서                                                                          │\n확인사항      │                                                                                              │\n────────┴───────────────────────────────────────────────┴──────\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n처 리 절 차\n───────────────────────────────────────────────────────────────\n이 신청서는 아래와 같이 처리됩니다.\n\n┌────────┐  ┌────────┐  ┌────────┐  ┌────────┐  ┌────────┐  ┌──────┐\n│신청서 제출     │?│접 수           │?│심 사           │?│인정여부 결정   │?│인정서 교부     │?│인정서 수령 │\n└────────┘  └────────┘  └────────┘  └────────┘  └────────┘  └──────┘\n신청인                처 리 기 관           처 리 기 관           처 리 기 관           처 리 기 관           신청인\n(방송통신위원회)      (방송통신위원회)      (방송통신위원회)      (방송통신위원회)\n───────────────────────────────────────────────────────────────\n210mm×297mm[백상지(80g/㎡)]\n■ 정보보호조치 및 안전진단 방법?절차?수수료에 관한 지침[별지 제4호서식] <개정 2012.3.15.>\n\n정보보호기술인력 보유현황\n\n(앞 쪽)\n────┬───────────────────────┬───────\n신청인│회사명 또는 상호                              │대표자 성명\n├───────────────────────┴───────\n│주소 또는 소재지\n├───────────────────────────────\n│정보보호기술인력의 총 수\n────┴───────────────────────────────\n\n───┬──┬────────┬───────────┬───┬────\n일련│성명│주소            │최종학력              │자격증│비 고\n번호│    ├────┬───┼───────────┤      │\n│    │생년월일│입사일│취득학위 및 학과(전공)│      │\n───┼──┼────┴───┼───────────┼───┼────\n│    │                │                      │      │\n│    ├────┬───┼───────────┤      │\n│    │        │      │                      │      │\n───┼──┼────┴───┼───────────┼───┼────\n│    │                │                      │      │\n│    ├────┬───┼───────────┤      │\n│    │        │      │                      │      │\n───┼──┼────┴───┼───────────┼───┼────\n│    │                │                      │      │\n│    ├────┬───┼───────────┤      │\n│    │        │      │                      │      │\n───┼──┼─