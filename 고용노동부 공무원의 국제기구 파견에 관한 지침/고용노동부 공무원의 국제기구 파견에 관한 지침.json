  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은 국제화·세계화의 조류에 부응하여, 노동부내 국제업무 전문가를 적극 양성·활용하고, 국제기구 파견시 기본원칙을 제공함으로써 노동행정의 국제화에 효율적으로 대처하는 것을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용) 이 지침은 ILO(제네바 본부, 방콕 지역사무소), OECD 등 국제기구에 파견되는 노동부 직원(이하 \"파견관\"이라 한다)에게 적용됨을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "파견기간",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(파견기간) 파견관의 파견기간은 최대 3년(2년 원칙, 1년 연장가능)으로 운영함으로써 공무원의 훈련기회의 확대를 도모한다. 이를 위해 파견관 선정시 파견기간 준수 여부를 고려하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "업무상황보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(업무상황보고) 파견관은 파견기간중 파견기구의 수임활동 이외에 다음 각호의 업무 상황 보고서를 노동부장관에게 제출하여야 한다.1. 업무계획서 제출최초 파견시 및 분기별 업무 계획서2. 활동동향 보고가. 분기별 보고  ① 제1호의 업무계획서에 따른 업무 추진 현황② ILO등 파견 국제기구와의 협력사업에 관한 진행경과 보고서나. 월별 보고  ① ILO 등 국제기구 관련 동향② 주재국의 노동 관련 동향 및 우리나라 노동분야와 관련된 언론 보도자료③ 기타 활동사항3. 귀국보고서 제출귀국 후 3월이내에 파견기간중 활동상황에 대한 보고서 제출4. 연구 보고서본인의 판단 또는 본부 지시에 따라 선정된 특정 주제에 대한 수시 연구보고서의 제출",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사후관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(사후관리) 총무과장은 파견관이 귀국 후 원칙적으로 국제관련업무 또는 파견기간중 수임활동과 관련된 업무에 종사케 함으로써 업무의 연계성 확보 및 전문지식의 활용을 도모한다.",
        "enforcement_date": "",
