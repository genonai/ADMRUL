  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은 국제화·세계화의 조류에 부응하여, 노동부내 국제업무 전문가를 적극 양성·활용하고, 국제기구 파견시 기본원칙을 제공함으로써 노동행정의 국제화에 효율적으로 대처하는 것을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용) 이 지침은 국제노동기구(ILO 제네바 본부, 방콕 지역사무소), 경제협력개발기구(OECD) 및 세계은행(WB) 등 국제기구에 파견되는 노동부 직원(이하 \"파견관\"이라 한다)에게 적용됨을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "파견기간",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(파견기간) 파견관의 파견기간은 최대 3년(2년 원칙, 1년 연장가능)으로 운영함으로써 공무원의 훈련기회의 확대를 도모한다. 이를 위해 파견관 선정시 파견기간 준수 여부를 고려하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "업무상황 등 보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(업무상황 등 보고) ① 파견관은 파견기간 중 주재국 또는 파견 국제기구의 노동동향이나 활동 등에 대하여 매년 2회 반기별로 보고하여야 한다.② 파견관은 노동부장관이 요청하는 주재국 또는 파견 국제기구의 노동동향이나 파견관의 업무·활동 등에 대하여 수시로 보고하여야 한다.③ 파견관은 귀국 후 3개월 이내에 파견기간 중 활동상황 등에 대하여 보고서를 제출하여야 한다.④ 국제협력관은 제1항 및 제2항에 따른 보고 사항 중 주재국 또는 파견 국제기구의 주요노동정책 등 중요한 사안을 노동부장관에게 보고한 후 관련 실·국장에게 통보하여 정책수립에 활용토록 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사후관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(사후관리) 노동부장관은 파견관이 귀국 후 원칙적으로 국제관련업무 또는 파견기간중 수임활동과 관련된 업무에 종사케 함으로써 업무의 연계성 확보 및 전문지식의 활용을 도모한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:노동부공무원의국제기구파견에관한지침#JO0005"
      }
    ]
