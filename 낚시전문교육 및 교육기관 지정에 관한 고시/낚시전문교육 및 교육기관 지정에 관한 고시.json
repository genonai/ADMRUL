  │          │        │        │    │\n├──┼──┼───┼────┼───────┼──┼──┼─────┼────┼────┼──┤\n│    │    │      │        │              │    │    │          │        │        │    │\n├──┼──┼───┼────┼───────┼──┼──┼─────┼────┼────┼──┤\n│    │    │      │        │              │    │    │          │        │        │    │\n├──┼──┼───┼────┼───────┼──┼──┼─────┼────┼────┼──┤\n│    │    │      │        │              │    │    │          │        │        │    │\n├──┼──┼───┼────┼───────┼──┼──┼─────┼────┼────┼──┤\n│    │    │      │        │              │    │    │          │        │        │    │\n└──┴──┴───┴────┴───────┴──┴──┴─────┴────┴────┴──┘\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n210mm×297mm[백상지 80g/㎡]\n\n",
