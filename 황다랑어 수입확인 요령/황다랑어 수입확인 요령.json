  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 요령은 전미열대다랑어보존위원회(IATTC) 국제 돌고래 보존 프로그램(AIDCP) 이행 결의안에 따른 황다랑어의 수입확인 업무에 필요한 방법과 절차를 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 이 요령은 산업통상자원부 「통합공고」 제6조 별표2 수입요령에 따라 브라질, 콜롬비아, 코스타리카, 키프로스, 에콰도르, 마이크로네시아, 온두라스, 라이베리아, 멕시코, 파나마, 스페인, 바누아투, 베네수엘라, 벨리즈에서 수입되는 황다랑어(HS 0302 32 00 00 및 0303 42 0000)에 대해 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "수입확인의 담당기관",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(수입확인의 담당기관) 이 요령에 의한 황다랑어 수입확인의 담당기관은 국립수산물품질관리원의 각 지원으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "확인신청 서류",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(확인신청 서류) 이 요령에 의하여 황다랑어 수입확인을 받고자 하는 자는 수입 통관 전에 별지 제1호서식의 황다랑어 수입확인 신청서에 별지 제3호의 수출국 정부 또는 정부공인기관이 발행한 원산지증명서(예시)를 첨부하여 수입수산물의 통관장소를 관할하는 국립수산물품질관리원의 지원장(이하 \"지원장\"이라 한다)에게 신청하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "확인요령",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(확인요령) 지원장은 원산지증명서를 검토하여 동부열대태평양에서 선망어법으로 어획되지 아니한 사실을 확인한 때에는 \"동부열대태평양에서 선망어법으로 어획된 황다랑어의 것이 아님\" 이라는 문구를 명시한 별지 제2호서식의 황다랑어 수입요건 확인서를 교부하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수입확인의 처리기간",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(수입확인의 처리기간) 수입확인의 처리기간은 접수한 날로부터 3일 이내로 한다. 다만, 서류의 보완을 위하여 필요한 기간은 이를 산입하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "사후관리",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(사후관리) 지원장은 수입확인 신청내용을 허위 기타 부정한 방법으로 작성하여 확인을 받은 사실이 발견된 때에는 확인의 취소등 필요한 조치를 취할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "재검토기한",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(재검토기한) 해양수산부장관은「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 이 고시에 대하여 2021년 1월 1일 기준으로 매3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:황다랑어수입확인요령#JO0008"
      }
    ]
  },
