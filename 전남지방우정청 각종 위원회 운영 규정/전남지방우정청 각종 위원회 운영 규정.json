  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 훈령은 전남지방우정청에 설치하는 각종 위원회의 구성과 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:전남지방우정청각종위원회운영세칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "위원회의 설치근거와 명칭",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(위원회의 설치근거와 명칭) 전남지방우정청에 설치 운영하는 위원회의 설치근거와 그 명칭은 \"별표1”과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:전남지방우정청각종위원회운영세칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "위원회 구성 및 기능",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(위원회 구성 및 기능) ①각 위원회의 구성 및 기능은 \"별표2”와 같다.② 전 항에 규정되지 아니한 위원회의 구성 및 운영에 관한 사항은 별도로 정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:전남지방우정청각종위원회운영세칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위원장의 임면",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(위원장의 임면) ① 위원장은 법령에 특별히 정한 경우를 제외하고는 당해 업무가 소속된 국의 국장이 된다.② 위원회의 위원장이 유고로 그 직무를 행할 수 없을 때에는 다른 규정에 특별한 규정이 있는 경우를 제외하고는 위원 중 직제 상 상위보직 순으로 그 권한을 대행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:전남지방우정청각종위원회운영세칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "각 위원의 임면",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(각 위원의 임면) 각 위원회의 위원은 \"별표3”의 당연직위로 하며, 해당직위 보임 및 해임일자에 자동적으로 임면된 것으로 본다. 다만, 위원의 유고로 인하여 위원회의 업무수행에 지장이 있다고 인정될 때에는 청장이 별도로 위원을 임명할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:전남지방우정청각종위원회운영세칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "위원회의 의결",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(위원회의 의결) 각 위원회 의결에 관하여 관계법령 및 다른 규정에 특별한 규정이 있는 경우를 제외하고는 위원장을 포함한 재적위원 과반수이상의 출석과 출석위원 과반수이상의 찬성으로 의결한다. 다만, 가부동수인 경우에는 위원장이 결정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:전남지방우정청각종위원회운영세칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "회의결과 기록",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(회의결과 기록) 각 위원회의 회의를 개최하였을 때에는 그 결과를 관계 회의록에 기록 관리하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:전남지방우정청각종위원회운영세칙#JO0007"
      }
    ]
