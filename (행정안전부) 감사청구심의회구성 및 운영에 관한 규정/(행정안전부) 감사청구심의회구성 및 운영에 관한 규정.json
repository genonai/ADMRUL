    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 지방자치법 제16조 및 동법시행령 제26조, 제27조의 규정에 의한 감사청구심의회(이하 \"심의회”라 한다)의 구성·운영 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(행정자치부)감사청구심의회구성및운영에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "감사청구심의회 구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(감사청구심의회 구성) ①심의회는 위원장과 부위원장 각 1명을 포함하여 9명으로 구성하고, 행정자치부장관이 지명하는 위원은 국장급 공무원(감사관은 당연직)으로 하되 4인 이하로 한다.②심의회의 회의내용 기록·관리 등의 사무를 처리하고 유효서명의 확인 등을 행하기 위하여 간사와 사무직원을 두되, 행정자치부 감사관실 소속 공무원으로 보한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(행정자치부)감사청구심의회구성및운영에관한규정#JO0002"
