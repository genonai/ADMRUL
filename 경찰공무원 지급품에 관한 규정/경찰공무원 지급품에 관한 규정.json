 ┃\n┗━┷━━━━━━━━━┷━━━┷━━━┷━━━━━━┷━━━┷━━━━┷━━━━━┛\n┏━━━━━━━━━━━━━━┯━━━┯━━━┯━━━┯━━━┯━━━┯━━━┓\n┃                 구 분      │호수  │수량/ │수량/ │수량/ │수량/ │수량/ ┃\n┃ 품  명                     │(치수)│지급일│지급일│지급일│지급일│지급일┃\n┠─┬────────────┼───┼───┼───┼───┼───┼───┨\n┃경│항 공 정 비 복          │      │      │      │      │      │      ┃\n┃찰├────────────┼───┼───┼───┼───┼───┼───┨\n┃제│경 찰 파 카             │      │      │      │      │      │      ┃\n┃복├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │겨울점퍼(내피겸용)      │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │방 한 파 카             │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │방  한  복              │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │겨 울 점 퍼             │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │가 죽 점 퍼             │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │봄 가 을 점 퍼          │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │감 식 점 퍼             │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │가 죽 바 지             │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │혹한 근무복 하의        │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │반 외 투                │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │사 복                   │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │기 마 훈 련 복          │      │      │      │      │      │      ┃\n┠─┼────────────┼───┼───┼───┼───┼───┼───┨\n┃경│단        화            │      │      │      │      │      │      ┃\n┃  ├────────────┼───┼───┼───┼───┼───┼───┨\n┃  │여 름 단 화             │      │      │      │      │      │      ┃\n┃찰├──────────