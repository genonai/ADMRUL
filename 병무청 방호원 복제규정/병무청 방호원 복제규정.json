    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 병무청 및 지방병무청에 근무하는 방호원 제복의 규격, 지급 및 착용에 관한 사항을 규정함에 있음",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(병무청)방호원복제규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "제복",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(제복) 방호원의 제복은 \"별표1\"과 같이 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(병무청)방호원복제규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "착용",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(착용) ①방호원은 근무시간에 제복과 제모를 착용하여야 한다.②동복 및 하복 착용시기는 공무원의 동복 및 하복착용시기에 준한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(병무청)방호원복제규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "대여품의 종류 및 대여기한",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(대여품의 종류 및 대여기한) ①방호원에게 지급되는 대여품의 종류 및 대여 기한은 다음과 같다.1. 동복 및 하복 2년간2. 모자 및 모표 3년간②제1항 각호의 대여연한이 경과한 대여품은 사물로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(병무청)방호원복제규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "반납",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(반납) 휴직, 퇴직 또는 전직되었을 때에는 대여기한내의 제복, 제모는 반납하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(병무청)방호원복제규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "변상",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(변상) 대여기한내에 사용자의 고의 또는 중대한 과실로 인하여 제복, 제모가 멸실 또는 훼손된 때에는 사용자가 이를 변상하여야 한다.",
        "enforcement_date": "",
