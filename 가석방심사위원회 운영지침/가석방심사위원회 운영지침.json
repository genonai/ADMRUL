      {
        "article_no": "제8조",
        "article_title": "심사방법",
        "chapter": "제5장  회의",
        "chapter_path": "제5장  회의",
        "content": "제8조(심사방법) 각 위원은 미리 배포된 가석방심사 자료를 검토하여 위원회에 그 의견을 상정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:가석방심사실무위원회운영규정#JO0008"
