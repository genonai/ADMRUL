    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 「국가공무원 복무규정」\n제9조(근무시간 등) 및",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경북지방우정청내우체국의업무취급시간에관한규정#JO0001"
      },
      {
        "article_no": "제12조",
        "article_title": "현업공무원의 근무시간과 근무일",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(현업공무원의 근무시간과 근무일), 「우정사업본부 현업관서직원 복무관리세칙」\n제3조(기본근무시간) 및\n제4조(근무시간), 「별정우체국 직원인사규칙」\n제19조(근무시간), 「우편업무 규정」\n제3조(창구취급시간)에 의하여 경북지방우정청 관내에 위치한 관서(출장소, 별정우체국 포함)의 창구업무 취급시간에 관하여 필요한 사항을 정하는 것을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경북지방우정청내우체국의업무취급시간에관한규정#JO0012"
      },
      {
        "article_no": "제2조",
        "article_title": "창구업무 취급시간",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(창구업무 취급시간) 경북지방우정청 관내에 위치한 관서(출장소, 별정우체국 포함)의 창구업무 취급시간은 오전 9시부터 오후 6시까지로 하며, 취급시간이 조정된 관서는 별표 1과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경북지방우정청내우체국의업무취급시간에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "창구업무 취급시간 조정",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(창구업무 취급시간 조정) 제2조에도 불구하고 긴급한 상황이 발생하는 등 우체국장이 필요하다고 인정하는 경우는 창구업무 취급시간을 조정할 수 있으며, 이 경우 우정청장에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:경북지방우정청내우체국의업무취급시간에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "취급시간 공지",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(취급시간 공지) ① 제2조 및 제3조에 따라 정한 창구업무 취급시간은 별표2를 참고하여 안내문 등을 제작하고 이를 공중실 벽면, 출입문 등 고객들이 알아보기 쉬운 곳에 부착하여야 한다.② 별표1에 따른 우체국별 창구업무 취급시간은 공고를 통해 우정청 관할지역 고객들이 알 수 있도록 하여야 한다.",
        "enforcement_date": "",
