        "chapter": "",
        "chapter_path": "",
        "content": "제2조(물이용부담금 부과율) 한강수계의 물이용부담금 부과율은 최종수요자의 물사용량 1톤당 170원으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:한강수계물이용부담금부과율#JO0002"
