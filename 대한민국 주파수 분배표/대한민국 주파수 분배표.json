        │\n│ 고정       │ 위성상호간     │ 고정                 ││ 고정                 │가입자 회선 K176        │\n│ 위성상호간 │ 무선항행       │ 위성상호간           ││ 위성상호간           │특정소출력(차량충돌     │\n│            │                │ 이동                 ││ 이동                 │방지레이더용) K37G      │\n│            │                │ 무선항행             ││                      │                        │\n│            │                │                      ││                      │                        │\n│            │                │                      ││                      │                        │\n│            │ 5.533          │ 5.533                ││ 5.533                │                        │\n├──────┼────────┼───────────┤├───────────┼────────────┤\n│24.65-24.75 │24.65-24.75     │24.65-24.75           ││24.65-24.75           │                        │\n│ 고정       │ 위성상호간     │ 고정                 ││ 고정                 │가입자 회선 K176        │\n│ 위성상호간 │ 무선표정위성   │ 위성상호간           ││ 위성상호간           │특정소출력(차량충돌     │\n│            │ (지구대우주)   │ 이동                 ││ 이동                 │방지레이더용) K37G      │\n│            │                │                      ││                      │                        │\n│            │                │                      ││                      │                        │\n│            │                │                      ││                      │                        │\n│            │                │ 5.533                ││ 5.533                │                        │\n├──────┼────────┼───────────┤├───────────┼────────────┤\n│24.75-25.25 │24.75-25.25     │24.75-25.25           ││24.75-25.25           │                        │\n│ 고정       │ 고정위성(지구대│ 고정                 ││ 고정                 │특정소출력(차량충돌     │\n│            │우주)           │ 고정위성(지구대우주) ││ 고정위성(지구대우주) │방지레이더용) K37G      │\n│            │   5.535        │             5.535    ││             5.535    │                        │\n│            │                │ 이동                 ││ 이동                 │                        │\n│            │                │                      ││                      │                        │\n│            │                │                      ││                      │                        │\n│            │                │                      ││                      │                        │\n└──────┴────────┴───────────┴┴───────────┴────────────┘\n25.25－29.5㎓\n┌────────────────────────┬┬─────────────────────┐\n│국                  제                          ││한            국                          │\n├─────┬─────┬────────────┤├──────────┬──────────┤\n│(1)       │(2)       │(3)                     ││(4)                 │(5)                 │\n├─────┼─────┼────────────┤├──────────┼──────────┤\n│제 1 지 역│제 2 지 역│제 3 지 역              ││주파수대별 분배     │용  도  등          │\n├─────┴─────┴────────────┤├──────────┼──────────┤\n│25.25-25.5                                      ││25.25-25.5          │특정소출력(차량충돌 │\n│             고정                               ││ 고정               │방지레이더용) K37G  │\n│             위성상호간 5.536                   ││ 위성상호간 5.536   │                    │\n│             이동                               ││ 이동               │                    │\n│             표준주파수 및 시보위성(지구대우주) ││ 표준주파수 및 시보 │                    │\n│                                                ││위성(지구대우주)    │                    │\n│                                                ││                    │                    │\n│                                                ││                    │                    │\n├────────────────────────┤├──────────┼──────────┤\n│25.5-27                                         ││25.5-27             │                    │\n│             지구탐사위성(우주대지구) 5.536B    ││ 고정               │가입자 회선, CATV   │\n│             고정                               ││ 위성상호간 5.536   │전송용 K176A        │\n│             위성상호간 5.536                   ││ 이동               │특정소출력(차량충돌 │\n│             이동                               ││                    │방지레이더용) K37G  │\n│             우주연구(우주대지구) 5.536C        ││                    │                    │\n│             표준주파수 및 시보위성(지구대우주) ││                    │                    │\n│                                                ││                    │                    │\n│             5.536A                             ││                    │                    │\n├─────────┬──────────────┤├──────────┼──────────┤\n│27-27.5           │27-27.5                     ││27-27.5             │                    │\n│ 고정             │ 고정                       ││ 고정               │CATV전송용 K176A    │\n│ 위성상호간 5.536 │ 고정위성(지구대우주)       ││                    │                    │\n│ 이동             │ 위성상호간 5.536 5.537     ││ 위성상호간 5.536   │                    │\n│                  │ 이동                       ││           5.537    │                    │\n│                  │                            ││ 이동               │                    │\n├─────────┴──────────────┤├──────────┼──────────┤\n│<생략>                                          ││<생략>              │<생략>              │\n└────────────────────────┴┴──────────┴──────────┘\n제4호 국내 주파수 분배표 주석 중 K37D, K37G, K90B, K90D를 다음과 같이 한다.\nK37D\n219.150 ㎒, 219.175 ㎒, 219.200 ㎒ 및 219.225 ㎒의 주파수는 음성호출로 사용할 수 있고, 72.610～73.910 ㎒, 74.000～74.800㎒, 75.620～75.790 ㎒, 173.020～173.280 ㎒, 173.300～174.000 ㎒, 216.000～217.000 ㎒, 217.250～220.110 ㎒, 223.000～225.000 ㎒, 740.000～752.000 ㎒ 및 925～932 ㎒의 주파수대역은 특정소출력무선기기(음성 및 음향신호전송용)로 사용할 수 있다. 다만, 740～752㎒의 주파수대역은 2012년 12월 31일까지(형식등록 종료는 2010년 12월 31일까지)만 사용을 허용한다.\nK37G\n24.25~26.65 ㎓ 및 76～77 ㎓의 주파수대역은 특정소출력무선기기(차량충돌방지레이더용)로 사용할 수 있다.\nK90B\n13552∼13568 ㎑의 주파수대역은 RFID/USN (Radio Frequency IDentification/Ubiquitous Sensor Network)용으로 사용할 수 있다.\nK90D\n915～923.5 ㎒의 주파수대역은 RFID/USN 등의 무선설비용으로 사용할 수 있고, 917～922.1 ㎒의 주파수대역은 영해 밖에서 비상통신 보조용으로 사용할 수 있다. 다만, 인접대역으로부터의 유해 간섭을 허용하고 동일 대역내에서의 유해 간섭을 상호 허용하는 조건으로 사용하여야 한다.\n\n부칙\n이 고시는 발령한 날부터 시행한다.",
  "revision_reason": "◇ 개정이유\n해경이 영해 밖에서 주통신이 불가능할 때 단말기 간의 비상통신보조용으로 사용하고, 자동차 사고예방 기술에 활용되는 차량충돌방지용레이더와 청각장애인의 수업에 필요한 무선보청기를 사용할 수 있도록 대한민국  주파수 분배표를 개정함\n◇ 주요내용\n가. 917～922.1㎒ 대역을 비상통신보조용으로 주파수를 분배하고 K90D 주석에 동 대역을 영해 밖에서 비상통신 보조용으로 사용하도록 추가(제2호, 제4호)\n나. 24.25∼26.65㎓ 대역을 차량충돌방지용레이더로 주파수를 분배하고 K37G 주석에 동 주파수를 추가(제2호, 제4호)\n다. 173.300～174.000㎒, 216.000～217.000㎒ 대역을 음성 및 음향신호 전송용으로 사용할 수 있도록 K37D 주석에 동 대역을 추가(제4호)",
