  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 국가공무원당직및비상근무규칙 제2조의 규정에 의한 국립춘천병원 당직근무자의 능률적인 업무수행을 도모하기 위한 제반사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "당직근무자의 임무",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(당직근무자의 임무) 당직근무자는 다음 각호의 사항을 성실히 이행함으로써 모든 사고의 발생을 미연에 방지하여야 한다.1. 방범, 방호, 방화 기타 보안상태의 순찰ㆍ점검2. 경비원 기타 정상근무시간외의 근무자에 대한 복무상태의 점검3. 문서의 수발ㆍ인계 또는 관리",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "경비원 지도감독",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(경비원 지도감독) 당직근무자는 제3조의 임무를 수행하기 위하여 필요한 경우 당일 근무 경비원을 지도 감독하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "내원환자 처리",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(내원환자 처리) 당직근무 중에 발생하는 다음 각호의 사항에 대하여는 당직근무자는 당직의사의 판단에 따라 필요한 조치를 취하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "외부진료",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(외부진료) 우리병원 입원환자가 정신질환이외의 다른 질환으로 타 진료과목의 진료를 요하는 환자가 발생시에는 당직근무자는 당직의사와 협조하여 응급차량 요청 등 필요한 조치를 취하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "응급차량 사용",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(응급차량 사용) 당직근무자가 근무 중 응급차량을 진료이외의 불가피한 사유로 사용코자 할 경우에는 당직의사의 사전협조를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "환자진료 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(환자진료 등) 당직근무 중 환자진료에 관한 응급조치에 관한 문의, 입원환자 면회 및 진료와 관련된 일체의 사항은 반드시 당직의사가 처리토록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "당직보고",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(당직보고) 당직근무자는 발생한 환자진료와 관련된 사항, 주요 업무연락사항 등을 당직근무일지에 기록하고, 익일 당직보고시에 서무과장에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "준용규정",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(준용규정) 당직근무에 관하여 이 규정에 명시되지 아니한 사항은 국가공무원당직및비상근무규칙을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립춘천병원당직근무규정#JO0009"
      }
    ]
  },
