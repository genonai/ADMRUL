             │  │1505│한울 5호기            │            │\n│            │                              │  │1506│한울 6호기            │            │\n│            │                              │  │1801│신한울 1호기          │            │\n│            │                              │  │1802│신한울 2호기          │            │\n│            │                              │─┴──┴───────────┘            │\n│            │                              │                                              │\n│            │                              │                                              │\n│            │                              │ - 대상시설의 2개 호기 공통의 경우에는        │\n│            │                              │아래요령에 따라 기입                          │\n│            │                              │  예) 고리 1?2호기의 경우 : 1212             │\n│            │                              │한빛 3?4호기의 경우 : 1434                   │\n│            │                              │ - 동일부지에서 추가되는 호기는 동일부지      │\n│            │                              │분류번호에서 순서대로 추가번호를 부여         │\n│            │                              │ - 신규로 건설?운영되는 원전은 새 번호를 부여│\n│            │                              │   예) 신한울 1800 등                         │\n│            │                              ├───────────────────────┤\n│            │                              │ o 연구용원자로시설(2000)                     │\n│            │                              │  ┌───┬──────────┐            │\n│            │                              │  │2101  │하나로 연구용원자로 │            │\n│            │                              │  │2102  │TRIGA MarkⅡ        │            │\n│            │                              │  │2103  │TRIGA MarkⅢ        │            │\n│            │                              │  │2104  │기장 연구용원자로   │            │\n│            │                              │─┴───┴──────────┘            │\n│            │                              │                                              │\n│            │                              ├───────────────────────┤\n│            │                              │ o 교육용원자로시설(3000)                     │\n│            │                              │  ┌───┬──────────┐            │\n│            │                              │  │3101  │AGN-201 (경희대학교)│            │\n│            │                              │─┴───┴──────────┘            │\n│            │                              │                                              │\n└──────┴───────────────┴───────────────────────┘\n┌─────┬───────────────┬───────────────────────┐\n│구  분    │코  드  구  성                │내          용                                │\n├─────┼───────────────┼───────────────────────┤\n│⑥검사대상│                              │                                              │\n│          │            ┌┬┐            │ o 검사대상이 원자로 및 관계시설인 경우 기재  │\n│          │            │││            │                                              │\n│          │            └┴┘            │                                              │\n│          │              (코드)          │                                              │\n│          │                              │                                              │\n│          │                              │  ┌─┬─────────────────┐  │\n│          │                              │  │01│원자로본체(핵연료포함)            │  │\n│          │                              │  │02│원자로냉각계통시설                │  │\n│          │                              │  │03│계측 및 제어계통시설              │  │\n│          │                              │  │04│핵연료물질의 취급시설 및 저장     │  │\n│          │                              │  │  │시설                              │  │\n│          │                              │  │05│방사성폐기물의 관리시설           │  │\n│          │                              │  │06│방사선관리시설                    │  │\n│          │                              │  │07│원자로격납시설                    │  │\n│          │                              │  │08│원자로안전계통시설                │  │\n│          │                              │  │09│전력계통시설                      │  │\n│          │                              │  │10│방사선 비상대응시설               │  │\n│          │                              │  │11│동력변환계통시설                  │  │\n│          │                              │  │18│2개 이상의 시설 및 계통           │  │\n│          │                              │  │19│기타 원자로의 안전에 관계되는 시설│  │\n│          │                              │─┴─┴─────────────────┴─│\n│          │                              │                                              │\n│          │                              ├───────────────────────┤\n│          │                              │ o 검사대상이 운영기술능력 및 품질보증검      │\n│          │                              │사인 경우 기재                                │\n│          │                              │┌───┬─────────────────┐│\n│          │                              ││98    │운영 기술능력                     ││\n│          │                              ││99    │품질보증검사                      ││\n│          │                              │└───┴─────────────────┘│\n│          │                              │                                              │\n├─────┼───────────────┼───────────────────────┤\n│⑧검사일자│                              │ o 검사자가 검사지적사항표를 작성한 날을      │\n│          │┌─────────────┐│기입하며, (년)은 뒤의 두자리 수, (월)과       │\n│          ││  .      .      .         ││(일)은 두자리 수를 기입.                      │\n│          │└─────────────┘│                                              │\n│          │                              │                                              │\n│          │                              │                                              │\n│          │                              │                                              │\n├─────┼───────────────┼───────────────────────┤\n│⑨발급일자│                              │ o 발급기관이 검사지적사항표를 수검기관에     │\n│          │┌─────────────┐│문서로 시행한 날을 기입하며, ⑧란의           │\n│          ││  .      .      .         ││검사일자 기입요령과 같다.                     │\n│          │└─────────────┘│                                              │\n│          │                              │                                              │\n├─────┼───────────────┼───────────────────────┤\n│⑪요구일자│                              │ o 발급기관이 검사지적사항을 수검기관에       │\n│          │┌─────────────┐│문서로 시행할 때 기입하며, ⑧란의             │\n│          ││  .      .      .         ││검사일자 기입요령과 같다.                     │\n│          │└─────────────┘│                                              │\n│          │                              │                                              │\n├─────┼───────────────┼───────────────────────┤\n│⑫종결일자│                              │ o 발급기관이 제10조에 따라 사업자에게        │\n│          │┌─────────────┐│종결을 통보한 날을 기준으로 하며, ⑧란의      │\n│          ││  .      .      .         ││검사일자 기입요령과 같다.                     │\n│          │└─────────────┘│                                              │\n│          │                              │                                              │\n│          │                              │                                              │\n│          │                              │                                              │\n└─────┴───────────────┴───────────────────────┘\n\n※ ①관리번호 ⑨발행일자 ⑪요구일자 ⑫종결일자는 검사지적사항표 발급기관에서 기입함.\n부칙\n제1조(시행일) 이 고시는 고시한 날부터 시행한다.\n제2조(경과조치) 이 고시의 시행당시 종전의 원자력안전위원회 고시 제2014-13호(원자력시설의 검사지적사항 처리에 관한 규정)에 따라 행한 행위는 이 고시에 따라 행한 것으로 본다.\n제3조(다른 고시의 개정) 원자로시설 안전관련설비의 공급자 등 검사에 관한 규정 일부를 다음과 같이 개정한다.\n제7조 중 \"제2013-06호(원자로시설의 검사지적사항 처리에 관한 규정)\"을 \"「원자로시설의 검사지적사항 처리에 관한 규정」\"으로 한다.",
