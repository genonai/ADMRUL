        "chapter": "",
        "chapter_path": "",
        "content": "제5조(전결권자의 책임) 이 규정에서 정한 전결사항에 대하여는 그 전결권자가 단장에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:동해어업관리단전결규정#JO0005"
