    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 대구·부산·광주고등검찰청 권역 관외 승진전출자의 원 소속 고등검찰청 권역 복귀와 검찰공무원 고충처리지침에 의거하여 전보고충을 제기한 직원에 대한 전입기준 수립을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:관외승진전출자전보인사처리지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (정의) ① 관외 승진전출자라 함은 대구·부산·광주고등검찰청 권역의 승진적체를 해소하기 위하여 서울고등검찰청 권역의 승진인원을 이체 후 서울고등검찰청 권역으로 승진임용 전보된 직원을 말한다.② 전보고충을 제기한 직원이라 함은 검찰공무원고충처리지침 제9조의 기준에 의하여 고충을 제기한 직원을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:관외승진전출자전보인사처리지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "보통고충심사위원회의 엄격심사",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조 (보통고충심사위원회의 엄격심사) 각 고등검찰청 및 지방검찰청에 설치된 보통고충심사위원회는 전보고충을 제기한 직원의 고충에 대하여 엄격히 심사하여 대검찰청 보통고충심사위원회에 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:관외승진전출자전보인사처리지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전보인사 기준",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조 (전보인사 기준) ① 관외 승진전출자는 승진 서열명부의 순위를 복귀 순위로 인정한다.② 대검찰청 보통고충심사위원회에 전보고충을 제기한 직원의 고충이 인용될 경우 관외 승진전출자의 후순위를 부여한다. 다만, 본인 및 직계존속의 중대한 질병 등의 사유로 보통고충심사위원회에서 인용될 경우 관외 승진전출자 보다 우선 전보할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:관외승진전출자전보인사처리지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "관외전출자 전입순위 통보",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조 (관외전출자 전입순위 통보) 대검찰청에서는 정기 인사 이후 대구·부산·광주고등검찰청에 관외 승진전출자의 해당 고등검찰청 권역 전입 순위를 통보하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:관외승진전출자전보인사처리지침#JO0005"
      }
