    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 훈령은 고용노동부 본부 및 소속기관에서 민원상담 및 민원 관계 서류를 처리하는 민원담당 공무원의 민원업무수당 지급에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:고용노동부민원담당공무원수당지급규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수당지급",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(수당지급) 다음 각 호의 업무를 수행하는 사람에 대하여는 「공무원 수당 등에 관한 규정」 제14조 및 관련 규정이 정하는 바에 따라 예산의 범위에서 민원업무수당을 지급할 수 있다.1. 본부 및 지방고용노동관서의 고객지원실과 고객상담센터에서 민원상담 및 민원관계 서류의 처리2. 지방고용노동관서의 고용센터에서 실업급여, 취업지원 및 직업능력개발 업무, 고용보험 피보험자격 관리, 고용장려금 지급, 외국인 고용허가 업무, 모성보호 업무 등에 관한 민원상담 및 민원관계 서류의 처리",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:고용노동부민원담당공무원수당지급규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "지급대상기관 및 범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(지급대상기관 및 범위) 수당의 지급대상 기관 및 인원은 별표와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:고용노동부민원담당공무원수당지급규정#JO0003"
