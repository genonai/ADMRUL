      {
        "article_no": "제5조",
        "article_title": "저작물등의 이용허락",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(저작물등의 이용허락) 국립국악원 저작물등의 이용허락에 관한 사항은 「국립국악원 자료관리규정」 제26조, 제27조를 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립국악원저작물관리규정#JO0005"
