┼─┼─┼─┼─┼─┼───┤\n│시    │통풍?환기장치 정상가동 여부            │  │  │  │  │  │      │\n│약    ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│및    │화학약품 정리정돈(시약병 밀봉 등) 여부  │  │  │  │  │  │      │\n│가    ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│스    │초자류의 안전관리상태                   │  │  │  │  │  │      │\n│      ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│      │시약의 성분 및 종류에 따른 적정보관 여부│  │  │  │  │  │      │\n│      ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│      │사용용기에 적정한 라벨 부착 여부        │  │  │  │  │  │      │\n│      ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│      │가스누출 여부                           │  │  │  │  │  │      │\n│      ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│      │가스용기의 고정 여부                    │  │  │  │  │  │      │\n│      ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│      │산소와 가연성가스 분리사용 여부         │  │  │  │  │  │      │\n├───┼────────────────────┼─┼─┼─┼─┼─┼───┤\n│시    │폐기물  보관용기의 적정 여부            │  │  │  │  │  │      │\n│험    ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│폐    │폐기물(일반/유해성)의 적정 분리처리 여부│  │  │  │  │  │      │\n│기    ├────────────────────┼─┼─┼─┼─┼─┼───┤\n│물    │시험 폐기물의 방치 여부                 │  │  │  │  │  │      │\n└───┴────────────────────┴─┴─┴─┴─┴─┴───┘\n※ 점검결과란 밑에는 점검날짜를 표기한다. (ex) 4/15\n※ 점검결과는 “양호”, “불량”으로 표기하며 “불량”에 대한 조치완료시 비고란에 조치일시 및 조치결과를 기록한다.\n210㎜×297㎜[백상지(80g/㎡) 또는 중질지(80g/㎡)]\n■ 해양오염물질 분석 및 분석실 운영 규칙［별지 제8호서식］\n┌──────────────────────────┬───────────────┐\n│분 석 안 전 교 육  기 록 부                         │┌─┬───┬───┬───┐│\n│                                                    ││결│계 원 │계 장 │과 장 ││\n│                                                    ││재├───┼───┼───┤│\n│                                                    ││  │      │      │      ││\n│                                                    ││  ├───┼───┼───┤│\n│                                                    ││  │/     │/     │/     ││\n│                                                    │└─┴───┴───┴───┘│\n├──────┬───────────────┬───┼───────────────┤\n│일  시      │                              │장  소│                              │\n├──────┼───────────────┼───┼───────────────┤\n│분석실      │                              │교  관│                              │\n│ 운영관리자 │          (서명 또는 인)      │      │                              │\n├──────┼───────────────┼───┴┬──────────────┤\n│교육인원    │대상자                        │참석여부│불참사유                    │\n│            ├───────────────┼────┼──────────────┤\n│            │                              │        │휴가/출장/교육/기타         │\n│            ├───────────────┼────┼──────────────┤\n│            │                              │        │                            │\n│            ├───────────────┼────┼──────────────┤\n│            │                              │        │                            │\n│            ├───────────────┼────┼──────────────┤\n│            │                              │        │                            │\n│            ├───────────────┼────┼──────────────┤\n│            │                              │        │                            │\n├──────┼───────────────┴────┴──────────────┤\n│교육내용    │                                                                      │\n├──────┴───────────────────────────────────┤\n│기타사항 (사진 등)                                                                  │\n└──────────────────────────────────────────┘\n210㎜×297㎜[백상지(80g/㎡) 또는 중질지(80g/㎡)]\n■ 해양오염물질 분석 및 분석실 운영 규칙［별지 제9호서식］\n┌───────────────────────────┬──────────────────┐\n│장 비 점 검 일 지                                     │┌─┬───┬───┬───┐      │\n│                                                      ││결│계 원 │계 장 │과 장 │      │\n│                                                      ││재├───┼───┼───┤      │\n│                                                      ││  │      │      │      │      │\n│                                                      ││  ├───┼───┼───┤      │\n│                                                      ││  │/     │/     │/     │      │\n│                                                      │└─┴───┴───┴───┘      │\n├─────┬───────────┬─────┬───┴────┬────┬────────┤\n│장비/물품명│                      │관리번호  │                │취득일자│                │\n├─────┼───────────┴─────┴────────┴────┴────────┤\n│장비담당자│                                                                                │\n├─┬───┴───────────┬────────────────────────┬───┤\n│No│점검사항                      │점검결과                                        │비 고 │\n│  │                              ├─┬─┬─┬─┬─┬─┬─┬─┬─┬──┬─┬─┤      │\n│  │                              │/ │/ │/ │/ │/ │/ │/ │/ │/ │/   │/ │/ │      │\n├─┼─┬─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│1 │관│  외관 상태               │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┤능├─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│2 │점│  주요 부품 파손  여부    │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┤검├─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│3 │  │  장비 청결 상태          │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┼─┼─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│4 │작│  장비 작동 상태(On, Off) │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┤동├─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│5 │점│  램프 작동 여부          │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┤검├─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│6 │  │  셀 상태                 │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┤  ├─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│7 │  │  가스누출 여부           │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┤  ├─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│8 │  │   진공상태 여부          │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┼─┴─────────────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┤\n│9 │  기타 점검사항               │  │  │  │  │  │  │  │  │  │    │  │  │      │\n├─┴───────────────┴─┴─┴─┴─┴─┴─┴─┴─┴─┴──┴─┴─┴───┤\n│  고장 및 정비이력 :  장비가 고장인 경우 고장일시 및 고장 내역 등 기록                      │\n│                                                                                            │\n│                                                                                            │\n└──────────────────────────────────────────────┘\n※ 점검결과에는 월별로 점검일자를 기록하고, “양호”, “불량”으로 표기.\n※ 불량에 대한 정비완료시 비고란에 정비이력 등 표기\n※ 점검사항은 분석장비의 종류에 따라 세부항목을 수정하여 점검할 수 있음.\n210㎜×297㎜[백상지(80g/㎡) 또는 중질지(80g/㎡)]\n■ 해양오염물질 분석 및 분석실 운영 규칙［별지 제10호서식］\n┌───────────────────────────────────────┐\n│장  비  관  리  대  장            ┌─┬───┬───┬───┐              │\n│                                  │결│계 원 │계 장 │과 장 │              │\n│                                  │재├───┼───┼───┤              │\n│                                  │  │      │      │      │              │\n│                                  │  ├───┼───┼───┤              │\n│                                  │  │/     │/     │/     │              │\n│                                  └─┴───┴───┴───┘              │\n└───────────────────────────────────────┘\n\n┌──┬────┬───┬───┬────┬────┬────┬────┬───┐\n│연번│관리번호│장비명│용  도│내용연수│취득일자│취득가격│불용여부│비 고 │\n│    │        │      │      │(년)    │(년,월) │(천원)  │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│1   │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│2   │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│    │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│    │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│    │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│    │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│    │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│    │        │      │      │        │        │        │        │      │\n├──┼────┼───┼───┼────┼────┼────┼────┼───┤\n│    │        │      │      │       