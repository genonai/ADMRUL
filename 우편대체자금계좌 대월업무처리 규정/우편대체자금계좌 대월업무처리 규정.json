        "chapter": "",
        "chapter_path": "",
        "content": "제3조(대월의 한도액) 계좌대월의 한도액은 금융기관의 당좌대월액을 감안하여 우정사업본부장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우편대체자금계좌대월업무처리규정#JO0003"
      },
      {
