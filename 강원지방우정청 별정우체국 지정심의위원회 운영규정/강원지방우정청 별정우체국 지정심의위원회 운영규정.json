  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "설치",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(설치)별정우체국법시행령 제5조의 규정에 따라 강원지방우정청에 강원지방우정청 별정우체국 지정 심사위원회(이하 위원회)를 둔다.\n제2조(목적)이 세칙은 위원회의 운영에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0001"
      },
      {
        "article_no": "제3조",
        "article_title": "임무",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(임무)위원회는 다음 각호의 사항을 심사한다.1. 별정우체국 지정의 해지 및 취소에 관한 사항2. 별정우체국의 신규지정, 재 지정 및 승계지정 시 피지정인의 자격요건 및 서류심사3. 추천국장의 자격요건 심사4. 기타 별정우체국 운영상의 주요문제 토의 결정",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(구성)위원회는 청장, 우정사업국장, 사업지원국장, 예금영업과장, 감사관, 인력계획과장과 외부전문가 1인을 포함하여 7인 이내의 위원으로 구성한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "위원장",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(위원장)①위원장은 청장이 된다.②위원장은 회의를 소집하고 주재한다.③위원장의 유고 시에는 청장의 법정대리자 순위에 따라 그 직무를 대행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "회의",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(회의)회의는 위원장을 포함한 재적위원 과반수 이상 참석으로 개회한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "지정의 심사기준",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(지정의 심사기준)별정우체국 지정 대상자의 심의의결은 별표1의 별정우체국지정 심사기준표에 따른다.1. 별정우체국법시행령(이하 \"영\"이라 한다) 제5조 제2항의 규정에 따른 우수여부  ① 제1항 제3호의 규정에 따른 우수여부는 별표1의 심사기준표에 따른 평가결과 합산점수가 가장 많은 자를 지정한다. 다만, 평가결과 합산점수는 60점 이상이어야 하고, 동점자가 발생할 경우 운영능력 중 사업계획서, 경력, 자격증 순으로 지정한다.② 제2항의 규정에 따른 심사대상자가 법 제4조 제1항 제1호의 규정에 따른 피지정인인 경우와, 법 제4조 제1항 제2호의 규정에 따른 피지정인의 추천을 받은 자인 경우 별표2의 배점기준에 따른 합산 점수가 60점 이상이어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "간사",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(간사)위원회의 사무를 처리하기 위하여 간사 1인을 두며 간사는 별정우체국 담당자로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "회의록",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(회의록)위원회의 심의사항은 회의록을 비치 기록하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "세부사항",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(세부사항)본 세칙 시행에 필요한 세부사항은 본 세칙에 저촉되지 않는 범위내에서 위원장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:강원지방우정청별정우체국지정심의위원회운영세칙#JO0010"
      }
    ]
