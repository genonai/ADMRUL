종              │대분류│중분류│소분류│내     용 │\n├──────────┼───┼───┼───┼─────┤\n│차량손괴            │4     │3     │03    │          │\n│                    │      │      │      │          │\n│연결기방해          │4     │3     │04    │          │\n│                    │      │      │      │          │\n│차량방해기타        │4     │3     │05    │          │\n│                    │      │      │      │          │\n│                    │      │      │      │          │\n│                    │      │      │      │          │\n│선로방해            │4     │4     │      │          │\n│                    │      │      │      │          │\n│물건방치            │4     │4     │01    │          │\n│                    │      │      │      │          │\n│선로파괴            │4     │4     │02    │          │\n│                    │      │      │      │          │\n│전철기방해          │4     │4     │03    │          │\n│                    │      │      │      │          │\n│선로통행            │4     │4     │04    │          │\n│                    │      │      │      │          │\n│건널목방해          │4     │4     │05    │          │\n│                    │      │      │      │          │\n│철도안전법위반기타  │4     │4     │06    │          │\n│                    │      │      │      │          │\n│                    │      │      │      │          │\n│                    │      │      │      │          │\n│기타범죄            │5     │      │      │          │\n│                    │      │      │      │          │\n│횡     령           │5     │1     │01    │          │\n│                    │      │      │      │          │\n│식품위생법          │5     │1     │02    │          │\n│                    │      │      │      │          │\n│여신금융업법        │5     │1     │03    │          │\n│                    │      │      │      │          │\n│마약류관리위반      │5     │1     │04    │          │\n│                    │      │      │      │          │\n│방      화          │5     │1     │05    │          │\n│                    │      │      │      │  