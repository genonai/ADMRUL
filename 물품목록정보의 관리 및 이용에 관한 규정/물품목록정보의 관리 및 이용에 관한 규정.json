        "chapter": "",
        "chapter_path": "",
        "content": "제9조(국가번호의 부여) (삭제)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:물품목록정보의관리및이용에관한규정#JO0009"
